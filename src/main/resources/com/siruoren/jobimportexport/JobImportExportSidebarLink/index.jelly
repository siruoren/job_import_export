<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form">
    <l:layout title="任务导入/导出">
        <l:main-panel>
            <h1>Jenkins 任务配置导入/导出</h1>

            <div id="modalOverlay"
                 style="display:none;
                        position:fixed;
                        inset:0;
                        background:rgba(0,0,0,.45);
                        z-index:9999;"></div>

            <div id="modalBox"
                 style="display:none;
                        position:fixed;
                        top:50%;
                        left:50%;
                        transform:translate(-50%,-50%);
                        background:#fff;
                        border-radius:10px;
                        width:auto;
                        max-width:90vw;
                        max-height:90vh;
                        min-width:400px;
                        padding:28px;
                        z-index:10000;
                        box-shadow:0 10px 40px rgba(0,0,0,.25);
                        overflow:hidden;">

                <h3 id="modalTitle"
                    style="margin:0 0 10px;
                           font-size:18px;
                           color:#222;">
                </h3>

                <div id="modalContent"
                     style="color:#666;
                            line-height:1.7;
                            font-size:14px;
                            max-height:calc(90vh - 180px);
                            overflow:auto;">
                </div>

                <div id="modalFooter" style="margin-top:24px;text-align:right;">
                </div>
            </div>

            <script>
                const JenkinsModal = {
                    el: null,
                    loading: false,

                    open({ title, content }) {
                        this.el = document.getElementById('modalBox');
                        document.getElementById('modalTitle').innerText = title;
                        document.getElementById('modalContent').innerHTML = content;

                        document.getElementById('modalOverlay').style.display = 'block';
                        this.el.style.display = 'block';
                    },

                    setContent(html) {
                        document.getElementById('modalContent').innerHTML = html;
                    },

                    setFooter(buttons = []) {
                        const footer = document.getElementById('modalFooter');
                        footer.innerHTML = '';

                        buttons.forEach(b => {
                            const btn = document.createElement('button');
                            btn.innerText = b.text;

                            btn.className =
                                'jenkins-button ' +
                                (b.type === 'primary' ? 'jenkins-button--primary' : '');

                            btn.onclick = b.onClick;
                            footer.appendChild(btn);
                        });
                    },

                    setLoading(flag) {
                        this.loading = flag;
                        document.body.style.cursor = flag ? 'wait' : '';
                    },

                    close() {
                        document.getElementById('modalOverlay').style.display = 'none';
                        document.getElementById('modalBox').style.display = 'none';
                    }
                };

                async function submit(form, extra = {}) {
                    JenkinsModal.setLoading(true);

                    try {
                        const fd = new FormData(form);
                        Object.entries(extra).forEach(([k, v]) => fd.set(k, v));

                        const res = await fetch(form.action, {
                            method: 'POST',
                            body: fd
                        });

                        const text = await res.text();
                        const result = JSON.parse(text);

                        JenkinsModal.setLoading(false);

                        JenkinsModal.setContent(renderResult(result));

                        const buttons = [{
                            text: '关闭',
                            type: 'default',
                            onClick: () => JenkinsModal.close()
                        }];

                        if (result.redirect) {
                            buttons.push({
                                text: '跳转',
                                type: 'primary',
                                onClick: () => location.href = result.redirect
                            });
                        }

                        if (result.dryRun &amp;&amp; result.success &amp;&amp; result.details &amp;&amp; result.details.length &gt; 0) {
                            buttons.unshift({
                                text: '确认导入',
                                type: 'primary',
                                onClick: () => confirmRealImport(form)
                            });
                        }

                        JenkinsModal.setFooter(buttons);

                    } catch (e) {
                        JenkinsModal.setLoading(false);
                        JenkinsModal.setContent('&lt;div style="color:#dc3545;"&gt;请求失败: ' + e + '&lt;/div&gt;');
                        JenkinsModal.setFooter([{
                            text: '关闭',
                            type: 'default',
                            onClick: () => JenkinsModal.close()
                        }]);
                    }
                }

                function renderResult(r) {
                    if (r.details &amp;&amp; r.details.length &gt; 0) {
                        let content = '&lt;div style="max-height:400px; overflow-y:auto;"&gt;';

                        if (r.dryRun) {
                            content += '&lt;p style="color:#17a2b8; font-weight:bold;"&gt;🔍 Dry Run 模式（仅检查，未实际导入）&lt;/p&gt;';
                        }

                        content += '&lt;p&gt;&lt;strong&gt;总计：&lt;/strong&gt;' + r.total + ' 个任务&lt;/p&gt;';
                        content += '&lt;p style="color:#28a745;"&gt;&lt;strong&gt;成功：&lt;/strong&gt;' + r.successCount + ' 个&lt;/p&gt;';

                        if (r.skipCount &gt; 0) {
                            content += '&lt;p style="color:#ffc107;"&gt;&lt;strong&gt;跳过：&lt;/strong&gt;' + r.skipCount + ' 个&lt;/p&gt;';
                        }

                        content += '&lt;p style="color:#dc3545;"&gt;&lt;strong&gt;失败：&lt;/strong&gt;' + r.failCount + ' 个&lt;/p&gt;';
                        content += '&lt;hr style="margin:16px 0; border:none; border-top:1px solid #eee;" /&gt;';
                        content += '&lt;table style="width:100%; border-collapse:collapse; font-size:13px;"&gt;';
                        content += '&lt;thead&gt;&lt;tr style="background:#f8f9fa;"&gt;&lt;th style="padding:8px; text-align:left; border-bottom:1px solid #ddd;"&gt;任务&lt;/th&gt;&lt;th style="padding:8px; text-align:left; border-bottom:1px solid #ddd;"&gt;最终名称&lt;/th&gt;&lt;th style="padding:8px; text-align:left; border-bottom:1px solid #ddd;"&gt;状态&lt;/th&gt;&lt;th style="padding:8px; text-align:left; border-bottom:1px solid #ddd;"&gt;消息&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;';
                        content += '&lt;tbody&gt;';

                        r.details.forEach(detail => {
                            let statusColor = '#666';
                            let statusIcon = '';

                            switch(detail.status) {
                                case 'OK':
                                case 'SUCCESS':
                                    statusColor = '#28a745';
                                    statusIcon = '✔ ';
                                    break;
                                case 'ERROR':
                                    statusColor = '#dc3545';
                                    statusIcon = '✘ ';
                                    break;
                                case 'SKIP':
                                case 'SKIP_EXISTS':
                                    statusColor = '#ffc107';
                                    statusIcon = '⏭ ';
                                    break;
                                case 'RENAME':
                                case 'RENAME_JOB':
                                case 'RENAME_FOLDER':
                                    statusColor = '#17a2b8';
                                    statusIcon = '↻ ';
                                    break;
                                case 'OVERWRITE':
                                case 'OVERWRITE_JOB':
                                    statusColor = '#fd7e14';
                                    statusIcon = '⚠ ';
                                    break;
                                case 'CREATE_FOLDER':
                                    statusColor = '#6f42c1';
                                    statusIcon = '📁 ';
                                    break;
                            }

                            content += '&lt;tr&gt;';
                            content += '&lt;td style="padding:8px; border-bottom:1px solid #eee;"&gt;' + escapeHtml(detail.jobPath) + '&lt;/td&gt;';

                            let finalName = escapeHtml(detail.finalName);
                            if (detail.finalName !== detail.jobPath) {
                                finalName = escapeHtml(detail.jobPath) + ' → ' + escapeHtml(detail.finalName);
                            }
                            content += '&lt;td style="padding:8px; border-bottom:1px solid #eee; color:#666;"&gt;' + finalName + '&lt;/td&gt;';
                            content += '&lt;td style="padding:8px; border-bottom:1px solid #eee; color:' + statusColor + '; font-weight:bold;"&gt;' + statusIcon + detail.status + '&lt;/td&gt;';
                            content += '&lt;td style="padding:8px; border-bottom:1px solid #eee; color:#666;"&gt;' + escapeHtml(detail.message) + '&lt;/td&gt;';
                            content += '&lt;/tr&gt;';
                        });

                        content += '&lt;/tbody&gt;&lt;/table&gt;';
                        content += '&lt;/div&gt;';
                        return content;
                    }

                    const color = r.success ? '#28a745' : '#dc3545';
                    return '&lt;div style="color:' + color + '; padding:10px;"&gt;' + escapeHtml(r.message) + '&lt;/div&gt;';
                }

                function removeToast(toast) {
                    if (!toast) return;
                    if (toast._timer) clearTimeout(toast._timer);
                    toast.style.opacity = '0';
                    toast.style.transform = 'translateY(-10px)';
                    setTimeout(() => {
                        if (toast.parentNode) toast.parentNode.removeChild(toast);
                    }, 250);
                }

                function showToast(type, message, duration = 10000) {
                    const containerId = 'toast-container';
                    let container = document.getElementById(containerId);

                    if (!container) {
                        container = document.createElement('div');
                        container.id = containerId;
                        container.style.position = 'fixed';
                        container.style.top = '24px';
                        container.style.right = '24px';
                        container.style.zIndex = '99999';
                        document.body.appendChild(container);
                    }

                    const toast = document.createElement('div');
                    toast.innerText = message;
                    toast.style.marginBottom = '10px';
                    toast.style.padding = '10px 14px';
                    toast.style.borderRadius = '6px';
                    toast.style.color = '#fff';
                    toast.style.fontSize = '13px';
                    toast.style.boxShadow = '0 6px 18px rgba(0,0,0,.15)';
                    toast.style.cursor = 'pointer';
                    toast.style.transition = 'all .3s ease';
                    toast.style.opacity = '1';
                    toast.style.background = type === 'success' ? '#28a745' : type === 'error' ? '#dc3545' : '#333';
                    toast.onclick = () => removeToast(toast);
                    container.appendChild(toast);

                    toast._timer = setTimeout(() => removeToast(toast), duration);
                }

                function escapeHtml(text) {
                    const div = document.createElement('div');
                    div.textContent = text;
                    return div.innerHTML;
                }

                function showBatchResult(result) {
                    let content = '&lt;div style="max-height:400px; overflow-y:auto;"&gt;';
                    
                    if (result.dryRun) {
                        content += '&lt;p style="color:#17a2b8; font-weight:bold;"&gt;🔍 Dry Run 模式（仅检查，未实际导入）&lt;/p&gt;';
                    }
                    
                    content += '&lt;p&gt;&lt;strong&gt;总计：&lt;/strong&gt;' + result.total + ' 个任务&lt;/p&gt;';
                    content += '&lt;p style="color:#28a745;"&gt;&lt;strong&gt;成功：&lt;/strong&gt;' + result.successCount + ' 个&lt;/p&gt;';
                    
                    if (result.skipCount &gt; 0) {
                        content += '&lt;p style="color:#ffc107;"&gt;&lt;strong&gt;跳过：&lt;/strong&gt;' + result.skipCount + ' 个&lt;/p&gt;';
                    }
                    
                    content += '&lt;p style="color:#dc3545;"&gt;&lt;strong&gt;失败：&lt;/strong&gt;' + result.failCount + ' 个&lt;/p&gt;';
                    content += '&lt;hr style="margin:16px 0; border:none; border-top:1px solid #eee;" /&gt;';
                    content += '&lt;table style="width:100%; border-collapse:collapse; font-size:13px;"&gt;';
                    content += '&lt;thead&gt;&lt;tr style="background:#f8f9fa;"&gt;&lt;th style="padding:8px; text-align:left; border-bottom:1px solid #ddd;"&gt;任务&lt;/th&gt;&lt;th style="padding:8px; text-align:left; border-bottom:1px solid #ddd;"&gt;最终名称&lt;/th&gt;&lt;th style="padding:8px; text-align:left; border-bottom:1px solid #ddd;"&gt;状态&lt;/th&gt;&lt;th style="padding:8px; text-align:left; border-bottom:1px solid #ddd;"&gt;消息&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;';
                    content += '&lt;tbody&gt;';
                    
                    result.details.forEach(detail => {
                        let statusColor = '#666';
                        let statusIcon = '';
                        
                        switch(detail.status) {
                            case 'OK':
                            case 'SUCCESS':
                                statusColor = '#28a745';
                                statusIcon = '✔ ';
                                break;
                            case 'ERROR':
                                statusColor = '#dc3545';
                                statusIcon = '✘ ';
                                break;
                            case 'SKIP':
                                statusColor = '#ffc107';
                                statusIcon = '⏭ ';
                                break;
                            case 'RENAME':
                                statusColor = '#17a2b8';
                                statusIcon = '↻ ';
                                break;
                            case 'OVERWRITE':
                                statusColor = '#fd7e14';
                                statusIcon = '⚠ ';
                                break;
                        }
                        
                        content += '&lt;tr&gt;';
                        content += '&lt;td style="padding:8px; border-bottom:1px solid #eee;"&gt;' + escapeHtml(detail.jobPath) + '&lt;/td&gt;';
                        
                        let finalName = escapeHtml(detail.finalName);
                        if (detail.finalName !== detail.jobPath) {
                            finalName = escapeHtml(detail.jobPath) + ' → ' + escapeHtml(detail.finalName);
                        }
                        content += '&lt;td style="padding:8px; border-bottom:1px solid #eee; color:#666;"&gt;' + finalName + '&lt;/td&gt;';
                        
                        content += '&lt;td style="padding:8px; border-bottom:1px solid #eee; color:' + statusColor + '; font-weight:bold;"&gt;' + statusIcon + detail.status + '&lt;/td&gt;';
                        
                        let message = escapeHtml(detail.message);
                        if (detail.missingPlugins &amp;&amp; detail.missingPlugins.length &gt; 0) {
                            message += '&lt;br /&gt;&lt;span style="color:#dc3545; font-size:12px;"&gt;缺少插件: ' + detail.missingPlugins.map(p => escapeHtml(p)).join(', ') + '&lt;/span&gt;';
                        }
                        content += '&lt;td style="padding:8px; border-bottom:1px solid #eee; color:#666;"&gt;' + message + '&lt;/td&gt;';
                        content += '&lt;/tr&gt;';
                    });
                    
                    content += '&lt;/tbody&gt;&lt;/table&gt;';
                    content += '&lt;/div&gt;';
                    
                    JenkinsModal.open({
                        title: result.dryRun ? '预演结果' : '批量导入结果',
                        content: content,
                        actions: []
                    });
                }

                function showBatchPreviewConfirm(result, form) {
                    let content = '&lt;div style="max-height:400px;overflow:auto;"&gt;';

                    content += '&lt;h3 style="color:#17a2b8;"&gt;预演完成 ✔&lt;/h3&gt;';
                    content += '&lt;p&gt;共 ' + result.total + ' 个任务&lt;/p&gt;';

                    content += '&lt;hr style="margin:16px 0; border:none; border-top:1px solid #eee;" /&gt;';

                    content += '&lt;ul style="list-style:none; padding:0;"&gt;';

                    result.details.forEach(d => {
                        content += '&lt;li style="padding:8px 0; border-bottom:1px solid #eee;"&gt;' +
                            escapeHtml(d.job) +
                            ' → ' +
                            escapeHtml(d.finalName) +
                            '&lt;/li&gt;';
                    });

                    content += '&lt;/ul&gt;';
                    content += '&lt;/div&gt;';

                    JenkinsModal.open({
                        title: '确认导入任务列表',
                        content: content,
                        actions: [{
                            text: '确认导入',
                            type: 'primary',
                            onClick: () => confirmRealImport(form)
                        }]
                    });
                }

                async function confirmRealImport(form) {
                    JenkinsModal.close();
                    JenkinsModal.setLoading(true);

                    try {
                        const fd = new FormData(form);
                        fd.set('dryRun', 'false');

                        const res = await fetch(form.action, {
                            method: 'POST',
                            body: fd
                        });

                        const text = await res.text();
                        const result = JSON.parse(text);

                        if (result.success) {
                            showToast('success', result.message);
                            if (result.redirect) {
                                setTimeout(() => location.href = result.redirect, 800);
                            }
                        } else {
                            showToast('error', result.message || '导入失败');
                        }

                    } catch (e) {
                        showToast('error', '导入失败: ' + e);
                    } finally {
                        JenkinsModal.setLoading(false);
                    }
                }

                function openImport() {
                    const name = document.getElementById('jobName').value;
                    JenkinsModal.open({
                        title: '确认创建任务',
                        content: '&lt;div&gt;是否确认创建任务「' + escapeHtml(name) + '」？&lt;/div&gt;'
                    });
                    JenkinsModal.setFooter([{
                        text: '取消',
                        type: 'default',
                        onClick: () => JenkinsModal.close()
                    }, {
                        text: '创建任务',
                        type: 'primary',
                        onClick: () => submit(document.getElementById('importForm'))
                    }]);
                }

                function openBatch() {
                    JenkinsModal.open({
                        title: '批量导入任务',
                        content: '&lt;div&gt;确认执行批量导入（支持失败重试）&lt;/div&gt;'
                    });
                    JenkinsModal.setFooter([{
                        text: '取消',
                        type: 'default',
                        onClick: () => JenkinsModal.close()
                    }, {
                        text: '开始导入',
                        type: 'primary',
                        onClick: () => submit(document.getElementById('batchImportForm'), { retry: true })
                    }]);
                }

                function listenProgress(batchId) {
                    const es = new EventSource('progress?batchId=' + batchId);

                    es.onmessage = e => {
                        const data = JSON.parse(e.data);
                        showToast('info', '进度 ' + data.overallProgress + '% - ' + data.currentJob);

                        if (data.status === 'DONE') {
                            es.close();
                        }
                    };

                    es.onerror = () => es.close();
                }
            </script>

            <div style="display:flex; gap:24px; width:100%;">
                <div style="flex:1; padding:20px; background-color:#f8f9fa; border:1px solid #dee2e6; border-radius:6px;">
                    <h2 style="margin-top:0; margin-bottom:12px; font-size:18px; color:#333;">导入任务配置</h2>
                    <p style="margin-bottom:16px; color:#666; font-size:14px;">上传 Jenkins 任务配置 XML 文件来创建新任务。</p>
                    <form method="post" action="import" enctype="multipart/form-data" accept-charset="UTF-8" id="importForm" style="text-align:left;">
                        <table class="form" style="width:100%;">
                            <tr>
                                <td class="label" style="width:100%; padding-bottom:12px;">
                                    <label for="jobName" style="font-weight:500; color:#333; font-size:14px;">任务/文件夹名称</label>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-bottom:12px;">
                                    <input type="text" name="jobName" id="jobName"
                                           class="setting-input" required="true"
                                           style="padding:6px 10px; border:1px solid #ccc; border-radius:4px; width:100%; box-sizing:border-box;" />
                                    <p class="description" style="margin-top:8px; color:#666; font-size:12px;">新任务的名称，如果要放在文件夹下，请使用 "文件夹/任务名" 格式</p>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-bottom:12px;">
                                    <label for="xmlFile" style="font-weight:500; color:#333; font-size:14px;">XML配置文件</label>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-bottom:12px;">
                                    <input type="file" name="xmlFile" id="xmlFile"
                                           accept=".xml" required="true"
                                           style="padding:6px 10px; border:1px solid #ccc; border-radius:4px; width:100%; box-sizing:border-box;"
                                           onchange="document.getElementById('fileName').textContent = this.files[0]?.name || '';" />
                                    <span id="fileName" style="margin-left:10px; color:#337ab7; font-size:13px;"></span>
                                    <p class="description" style="margin-top:8px; color:#666; font-size:12px;">Jenkins 任务配置的 XML 文件</p>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-top:8px;">
                                    <button type="button" class="jenkins-button jenkins-button--primary" style="padding:8px 16px;"
                                            onclick="openImport()">
                                        导入任务配置
                                    </button>
                                </td>
                            </tr>
                        </table>
                    </form>
                </div>

                <div style="flex:1; padding:20px; background-color:#f8f9fa; border:1px solid #dee2e6; border-radius:6px;">
                    <h2 style="margin-top:0; margin-bottom:12px; font-size:18px; color:#333;">批量导入任务</h2>
                    <p style="margin-bottom:16px; color:#666; font-size:14px;">上传包含多个任务配置的 ZIP 文件来批量创建任务。</p>
                    <form method="post" action="batchImport" enctype="multipart/form-data" accept-charset="UTF-8" id="batchImportForm" style="text-align:left;">
                        <table class="form" style="width:100%;">
                            <tr>
                                <td class="label" style="width:100%; padding-bottom:12px;">
                                    <label for="zipFile" style="font-weight:500; color:#333; font-size:14px;">ZIP 文件</label>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-bottom:12px;">
                                    <input type="file" name="zipFile" id="zipFile"
                                           accept=".zip" required="true"
                                           style="padding:6px 10px; border:1px solid #ccc; border-radius:4px; width:100%; box-sizing:border-box;"
                                           onchange="document.getElementById('zipFileName').textContent = this.files[0]?.name || '';" />
                                    <span id="zipFileName" style="margin-left:10px; color:#337ab7; font-size:13px;"></span>
                                    <p class="description" style="margin-top:8px; color:#666; font-size:12px;">包含任务配置的 ZIP 文件，支持目录结构（job/config.xml）或扁平结构（job.xml）</p>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-bottom:12px;">
                                    <label style="font-weight:500; color:#333; font-size:14px;">导入选项</label>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-bottom:8px;">
                                    <input type="checkbox" name="dryRun" id="dryRun" value="true" style="margin-right:8px;" checked="checked" />
                                    <label for="dryRun" style="color:#333; font-size:13px;">Dry Run（仅检查不导入）</label>
                                    <p class="description" style="margin-top:4px; color:#666; font-size:12px;">勾选后仅检查任务配置，不实际导入。推荐先使用此模式检查后再导入</p>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-bottom:8px;">
                                    <input type="checkbox" name="overwrite" id="overwrite" value="true" style="margin-right:8px;" />
                                    <label for="overwrite" style="color:#333; font-size:13px;">覆盖已存在的任务</label>
                                    <p class="description" style="margin-top:4px; color:#666; font-size:12px;">勾选后，如果任务已存在则覆盖原任务（会自动备份原配置）</p>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-bottom:12px;">
                                    <input type="checkbox" name="rename" id="rename" value="true" style="margin-right:8px;" />
                                    <label for="rename" style="color:#333; font-size:13px;">自动重命名冲突任务</label>
                                    <p class="description" style="margin-top:4px; color:#666; font-size:12px;">勾选后，如果任务已存在则自动重命名（test → test_1 → test_2）</p>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-top:8px;">
                                    <button type="button" class="jenkins-button jenkins-button--primary" style="padding:8px 16px;"
                                            onclick="openBatch()">
                                        批量导入
                                    </button>
                                </td>
                            </tr>
                        </table>
                    </form>
                </div>
            </div>
        </l:main-panel>
    </l:layout>
</j:jelly>