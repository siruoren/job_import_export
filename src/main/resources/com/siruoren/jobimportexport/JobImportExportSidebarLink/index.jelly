<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form">
    <l:layout title="${%page.title}">
        <l:main-panel>
            <h1>${%page.heading}</h1>

            <div id="modalOverlay"
                 style="display:none;
                        position:fixed;
                        inset:0;
                        background:rgba(0,0,0,.45);
                        z-index:9999;"></div>

            <div id="modalBox"
                 style="display:none;
                        position:fixed;
                        top:50%;
                        left:50%;
                        transform:translate(-50%,-50%);
                        background:#fff;
                        border-radius:10px;
                        width:auto;
                        max-width:90vw;
                        max-height:90vh;
                        min-width:400px;
                        padding:28px;
                        z-index:10000;
                        box-shadow:0 10px 40px rgba(0,0,0,.25);
                        overflow:hidden;">

                <h3 id="modalTitle"
                    style="margin:0 0 10px;
                           font-size:18px;
                           color:#222;">
                </h3>

                <div id="modalContent"
                     style="color:#666;
                            line-height:1.7;
                            font-size:14px;
                            max-height:calc(90vh - 180px);
                            overflow:auto;">
                </div>

                <div id="modalFooter" style="margin-top:24px;text-align:right;">
                </div>
            </div>

            <script>
                var i18n = {
                    close: '${%modal.btn.close}',
                    jump: '${%modal.btn.jump}',
                    confirmImport: '${%import.btn.confirmImport}',
                    importing: '${%import.importing}',
                    importSuccess: '${%import.success}',
                    importFailed: '${%import.failed}',
                    importError: '${%import.error}',
                    exportSuccess: '${%export.success}',
                    exportFailed: '${%export.failed}',
                    exportError: '${%export.error}',
                    requestFailed: '${%result.requestFailed}',
                    nonJson: '${%result.nonJson}',
                    dryRunMode: '${%import.dryRun.mode}',
                    total: '${%result.label.total}',
                    success: '${%result.label.success}',
                    skipped: '${%result.label.skipped}',
                    failed: '${%result.label.failed}',
                    jobs: '${%result.label.jobs}',
                    job: '${%result.table.job}',
                    finalName: '${%result.table.finalName}',
                    status: '${%result.table.status}',
                    message: '${%result.table.message}',
                    jobPath: '${%result.table.path}',
                    exported: '${%result.label.exported}',
                    missingPlugins: '${%result.label.missingPlugins}',
                    progressStatus: '${%progress.status}',
                    batchImportDryRunTitle: '${%import.modal.title.dryrun}',
                    batchImportTitle: '${%import.modal.title}',
                    batchImportDryRunContent: '${%import.modal.content.dryrun}',
                    batchImportContent: '${%import.modal.content}',
                    startCheck: '${%import.btn.startCheck}',
                    startImport: '${%import.btn.startImport}',
                    exportModalTitle: '${%export.modal.title}',
                    exportModalContent: '${%export.exporting}',
                    dryRunResult: '${%result.dryRun}',
                    importResult: '${%result.import}',
                    previewResult: '${%result.preview}',
                    previewDone: '${%result.previewDone}'
                };
                const JenkinsModal = {
                    el: null,
                    loading: false,

                    open({ title, content }) {
                        this.el = document.getElementById('modalBox');
                        document.getElementById('modalTitle').innerText = title;
                        document.getElementById('modalContent').innerHTML = content;

                        document.getElementById('modalOverlay').style.display = 'block';
                        this.el.style.display = 'block';
                    },

                    setContent(html) {
                        document.getElementById('modalContent').innerHTML = html;
                    },

                    setFooter(buttons = []) {
                        const footer = document.getElementById('modalFooter');
                        footer.innerHTML = '';

                        buttons.forEach(b => {
                            const btn = document.createElement('button');
                            btn.innerText = b.text;

                            btn.className =
                                'jenkins-button ' +
                                (b.type === 'primary' ? 'jenkins-button--primary' : '');

                            btn.onclick = b.onClick;
                            footer.appendChild(btn);
                        });
                    },

                    setLoading(flag) {
                        this.loading = flag;
                        document.body.style.cursor = flag ? 'wait' : '';
                    },

                    close() {
                        document.getElementById('modalOverlay').style.display = 'none';
                        document.getElementById('modalBox').style.display = 'none';
                    }
                };

                async function submit(form, extra = {}) {
                    try {
                        const fd = new FormData(form);
                        Object.entries(extra).forEach(([k, v]) => fd.set(k, v));

                        const conflictMode = document.querySelector('input[name="conflictMode"]:checked');
                        if (conflictMode) {
                            fd.set('overwrite', conflictMode.value === 'overwrite' ? 'true' : 'false');
                            fd.set('rename', conflictMode.value === 'rename' ? 'true' : 'false');
                        }

                        const res = await fetch(form.action, {
                            method: 'POST',
                            body: fd
                        });

                        const text = await res.text();
                        const result = JSON.parse(text);

                        if (result.async &amp;&amp; result.batchId) {
                            showProgressBar();
                            var progressBar = document.getElementById('importProgressBar');
                            var progressText = document.getElementById('importProgressText');
                            listenProgress(result.batchId, progressBar, progressText, form);
                        } else {
                            showImportResult(result, form);
                        }

                    } catch (e) {
                        JenkinsModal.setLoading(false);
                        JenkinsModal.setContent('&lt;div style="color:#dc3545;"&gt;' + i18n.requestFailed.replace('{0}', e) + '&lt;/div&gt;');
                        JenkinsModal.setFooter([{
                            text: i18n.close,
                            type: 'default',
                            onClick: () => JenkinsModal.close()
                        }]);
                    }
                }

                function renderResult(r) {
                    if (r.details &amp;&amp; r.details.length &gt; 0) {
                        let content = '&lt;div style="max-height:400px; overflow-y:auto;"&gt;';

                        if (r.dryRun) {
                            content += '&lt;p style="color:#17a2b8; font-weight:bold;"&gt;' + i18n.dryRunMode + '&lt;/p&gt;';
                        }

                        content += '&lt;p&gt;&lt;strong&gt;' + i18n.total + '：&lt;/strong&gt;' + r.total + ' ' + i18n.jobs + '&lt;/p&gt;';
                        content += '&lt;p style="color:#28a745;"&gt;&lt;strong&gt;' + i18n.success + '：&lt;/strong&gt;' + r.successCount + '&lt;/p&gt;';

                        if (r.skipCount &gt; 0) {
                            content += '&lt;p style="color:#ffc107;"&gt;&lt;strong&gt;' + i18n.skipped + '：&lt;/strong&gt;' + r.skipCount + '&lt;/p&gt;';
                        }

                        content += '&lt;p style="color:#dc3545;"&gt;&lt;strong&gt;' + i18n.failed + '：&lt;/strong&gt;' + r.failCount + '&lt;/p&gt;';
                        content += '&lt;hr style="margin:16px 0; border:none; border-top:1px solid #eee;" /&gt;';
                        content += '&lt;table style="width:100%; border-collapse:collapse; font-size:13px; table-layout:fixed;"&gt;';
                        content += '&lt;thead&gt;&lt;tr style="background:#f8f9fa;"&gt;&lt;th style="padding:4px 6px; text-align:left; border-bottom:1px solid #ddd; width:28%;"&gt;' + i18n.job + '&lt;/th&gt;&lt;th style="padding:4px 6px; text-align:left; border-bottom:1px solid #ddd; width:28%;"&gt;' + i18n.finalName + '&lt;/th&gt;&lt;th style="padding:4px 6px; text-align:left; border-bottom:1px solid #ddd; width:14%;"&gt;' + i18n.status + '&lt;/th&gt;&lt;th style="padding:4px 6px; text-align:left; border-bottom:1px solid #ddd; width:30%;"&gt;' + i18n.message + '&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;';
                        content += '&lt;tbody&gt;';

                        r.details.forEach(detail => {
                            let statusColor = '#666';
                            let statusIcon = '';
                            let statusCode = detail.statusCode || detail.status;

                            switch(statusCode) {
                                case 'OK':
                                case 'SUCCESS':
                                    statusColor = '#28a745';
                                    statusIcon = '✔ ';
                                    break;
                                case 'ERROR':
                                case 'ERROR_INVALID_NAME':
                                case 'ERROR_PLUGIN':
                                    statusColor = '#dc3545';
                                    statusIcon = '✘ ';
                                    break;
                                case 'SKIP':
                                case 'SKIP_EXISTS':
                                case 'SKIP_EMPTY':
                                case 'SKIP_FOLDER_MISSING':
                                    statusColor = '#ffc107';
                                    statusIcon = '⏭ ';
                                    break;
                                case 'RENAME':
                                case 'RENAME_JOB':
                                case 'RENAME_FOLDER':
                                    statusColor = '#17a2b8';
                                    statusIcon = '↻ ';
                                    break;
                                case 'OVERWRITE':
                                case 'OVERWRITE_JOB':
                                case 'OVERWRITE_FOLDER':
                                    statusColor = '#fd7e14';
                                    statusIcon = '⚠ ';
                                    break;
                                case 'CREATE_FOLDER':
                                    statusColor = '#6f42c1';
                                    statusIcon = '📁 ';
                                    break;
                                case 'CREATE_JOB':
                                    statusColor = '#28a745';
                                    statusIcon = '📄 ';
                                    break;
                                case 'UPDATE_CONFIG':
                                    statusColor = '#17a2b8';
                                    statusIcon = '🔄 ';
                                    break;
                                case 'REUSE_FOLDER':
                                case 'REUSE':
                                    statusColor = '#6c757d';
                                    statusIcon = '📂 ';
                                    break;
                                case 'BLOCKED':
                                case 'CONFLICT':
                                    statusColor = '#dc3545';
                                    statusIcon = '🚫 ';
                                    break;
                            }

                            content += '&lt;tr&gt;';
                            content += '&lt;td style="padding:4px 6px; border-bottom:1px solid #eee; color:#666; word-break:break-all; line-height:1.4;"&gt;' + escapeHtml(detail.fullPath || detail.jobPath) + '&lt;/td&gt;';

                            let finalName = escapeHtml(detail.fullPath || detail.finalName);
                            if (detail.finalName !== detail.jobPath) {
                                finalName = escapeHtml(detail.fullPath || detail.jobPath) + ' → ' + escapeHtml(detail.fullPath || detail.finalName);
                            }
                            content += '&lt;td style="padding:4px 6px; border-bottom:1px solid #eee; color:#666; word-break:break-all; line-height:1.4;"&gt;' + finalName + '&lt;/td&gt;';
                            content += '&lt;td style="padding:4px 6px; border-bottom:1px solid #eee; color:' + statusColor + '; font-weight:bold; white-space:nowrap;"&gt;' + statusIcon + escapeHtml(detail.status) + '&lt;/td&gt;';
                            content += '&lt;td style="padding:4px 6px; border-bottom:1px solid #eee; color:#666; word-break:break-all; line-height:1.4;"&gt;' + escapeHtml(detail.message) + '&lt;/td&gt;';
                            content += '&lt;/tr&gt;';
                        });

                        content += '&lt;/tbody&gt;&lt;/table&gt;';
                        content += '&lt;/div&gt;';
                        return content;
                    }

                    const color = r.success ? '#28a745' : '#dc3545';
                    return '&lt;div style="color:' + color + '; padding:10px;"&gt;' + escapeHtml(r.message) + '&lt;/div&gt;';
                }

                function removeToast(toast) {
                    if (!toast) return;
                    if (toast._timer) clearTimeout(toast._timer);
                    toast.style.opacity = '0';
                    toast.style.transform = 'translateY(-10px)';
                    setTimeout(() => {
                        if (toast.parentNode) toast.parentNode.removeChild(toast);
                    }, 250);
                }

                function showToast(type, message, duration = 10000) {
                    const containerId = 'toast-container';
                    let container = document.getElementById(containerId);

                    if (!container) {
                        container = document.createElement('div');
                        container.id = containerId;
                        container.style.position = 'fixed';
                        container.style.top = '24px';
                        container.style.right = '24px';
                        container.style.zIndex = '99999';
                        document.body.appendChild(container);
                    }

                    const toast = document.createElement('div');
                    toast.innerText = message;
                    toast.style.marginBottom = '10px';
                    toast.style.padding = '10px 14px';
                    toast.style.borderRadius = '6px';
                    toast.style.color = '#fff';
                    toast.style.fontSize = '13px';
                    toast.style.boxShadow = '0 6px 18px rgba(0,0,0,.15)';
                    toast.style.cursor = 'pointer';
                    toast.style.transition = 'all .3s ease';
                    toast.style.opacity = '1';
                    toast.style.background = type === 'success' ? '#28a745' : type === 'error' ? '#dc3545' : '#333';
                    toast.onclick = () => removeToast(toast);
                    container.appendChild(toast);

                    toast._timer = setTimeout(() => removeToast(toast), duration);
                }

                function escapeHtml(text) {
                    const div = document.createElement('div');
                    div.textContent = text;
                    return div.innerHTML;
                }

                function showBatchResult(result) {
                    let content = '&lt;div style="max-height:400px; overflow-y:auto;"&gt;';
                    
                    if (result.dryRun) {
                        content += '&lt;p style="color:#17a2b8; font-weight:bold;"&gt;' + i18n.dryRunMode + '&lt;/p&gt;';
                    }
                    
                    content += '&lt;p&gt;&lt;strong&gt;' + i18n.total + '：&lt;/strong&gt;' + result.total + ' ' + i18n.jobs + '&lt;/p&gt;';
                    content += '&lt;p style="color:#28a745;"&gt;&lt;strong&gt;' + i18n.success + '：&lt;/strong&gt;' + result.successCount + '&lt;/p&gt;';
                    
                    if (result.skipCount &gt; 0) {
                        content += '&lt;p style="color:#ffc107;"&gt;&lt;strong&gt;' + i18n.skipped + '：&lt;/strong&gt;' + result.skipCount + '&lt;/p&gt;';
                    }
                    
                    content += '&lt;p style="color:#dc3545;"&gt;&lt;strong&gt;' + i18n.failed + '：&lt;/strong&gt;' + result.failCount + '&lt;/p&gt;';
                    content += '&lt;hr style="margin:16px 0; border:none; border-top:1px solid #eee;" /&gt;';
                    content += '&lt;table style="width:100%; border-collapse:collapse; font-size:13px; table-layout:fixed;"&gt;';
                    content += '&lt;thead&gt;&lt;tr style="background:#f8f9fa;"&gt;&lt;th style="padding:4px 6px; text-align:left; border-bottom:1px solid #ddd; width:28%;"&gt;' + i18n.job + '&lt;/th&gt;&lt;th style="padding:4px 6px; text-align:left; border-bottom:1px solid #ddd; width:28%;"&gt;' + i18n.finalName + '&lt;/th&gt;&lt;th style="padding:4px 6px; text-align:left; border-bottom:1px solid #ddd; width:14%;"&gt;' + i18n.status + '&lt;/th&gt;&lt;th style="padding:4px 6px; text-align:left; border-bottom:1px solid #ddd; width:30%;"&gt;' + i18n.message + '&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;';
                    content += '&lt;tbody&gt;';
                    
                    result.details.forEach(detail => {
                        let statusColor = '#666';
                        let statusIcon = '';
                        let statusCode = detail.statusCode || detail.status;
                        
                        switch(statusCode) {
                            case 'OK':
                            case 'SUCCESS':
                                statusColor = '#28a745';
                                statusIcon = '✔ ';
                                break;
                            case 'ERROR':
                            case 'ERROR_INVALID_NAME':
                            case 'ERROR_PLUGIN':
                                statusColor = '#dc3545';
                                statusIcon = '✘ ';
                                break;
                            case 'SKIP':
                            case 'SKIP_EXISTS':
                            case 'SKIP_EMPTY':
                            case 'SKIP_FOLDER_MISSING':
                                statusColor = '#ffc107';
                                statusIcon = '⏭ ';
                                break;
                            case 'RENAME':
                            case 'RENAME_JOB':
                            case 'RENAME_FOLDER':
                                statusColor = '#17a2b8';
                                statusIcon = '↻ ';
                                break;
                            case 'OVERWRITE':
                            case 'OVERWRITE_JOB':
                            case 'OVERWRITE_FOLDER':
                                statusColor = '#fd7e14';
                                statusIcon = '⚠ ';
                                break;
                            case 'CREATE_FOLDER':
                                statusColor = '#6f42c1';
                                statusIcon = '📁 ';
                                break;
                            case 'CREATE_JOB':
                                statusColor = '#28a745';
                                statusIcon = '📄 ';
                                break;
                            case 'UPDATE_CONFIG':
                                statusColor = '#17a2b8';
                                statusIcon = '🔄 ';
                                break;
                            case 'REUSE_FOLDER':
                            case 'REUSE':
                                statusColor = '#6c757d';
                                statusIcon = '📂 ';
                                break;
                            case 'BLOCKED':
                            case 'CONFLICT':
                                statusColor = '#dc3545';
                                statusIcon = '🚫 ';
                                break;
                        }
                        
                        content += '&lt;tr&gt;';
                        content += '&lt;td style="padding:4px 6px; border-bottom:1px solid #eee; color:#666; word-break:break-all; line-height:1.4;"&gt;' + escapeHtml(detail.fullPath || detail.jobPath) + '&lt;/td&gt;';
                        
                        let finalName = escapeHtml(detail.fullPath || detail.finalName);
                        if (detail.finalName !== detail.jobPath) {
                            finalName = escapeHtml(detail.fullPath || detail.jobPath) + ' → ' + escapeHtml(detail.fullPath || detail.finalName);
                        }
                        content += '&lt;td style="padding:4px 6px; border-bottom:1px solid #eee; color:#666; word-break:break-all; line-height:1.4;"&gt;' + finalName + '&lt;/td&gt;';
                        
                        content += '&lt;td style="padding:4px 6px; border-bottom:1px solid #eee; color:' + statusColor + '; font-weight:bold; white-space:nowrap;"&gt;' + statusIcon + escapeHtml(detail.status) + '&lt;/td&gt;';
                        
                        let message = escapeHtml(detail.message);
                        if (detail.missingPlugins &amp;&amp; detail.missingPlugins.length &gt; 0) {
                            message += '&lt;br /&gt;&lt;span style="color:#dc3545; font-size:12px;"&gt;' + i18n.missingPlugins + ': ' + detail.missingPlugins.map(p => escapeHtml(p)).join(', ') + '&lt;/span&gt;';
                        }
                        content += '&lt;td style="padding:4px 6px; border-bottom:1px solid #eee; color:#666; word-break:break-all; line-height:1.4;"&gt;' + message + '&lt;/td&gt;';
                        content += '&lt;/tr&gt;';
                    });
                    
                    content += '&lt;/tbody&gt;&lt;/table&gt;';
                    content += '&lt;/div&gt;';
                    
                    JenkinsModal.open({
                        title: result.dryRun ? i18n.dryRunResult : i18n.importResult,
                        content: content,
                        actions: []
                    });
                }

                function showBatchPreviewConfirm(result, form) {
                    let content = '&lt;div style="max-height:400px;overflow:auto;"&gt;';

                    content += '&lt;h3 style="color:#17a2b8;"&gt;' + i18n.previewDone + '&lt;/h3&gt;';
                    content += '&lt;p&gt;' + i18n.total + ' ' + result.total + ' ' + i18n.jobs + '&lt;/p&gt;';

                    content += '&lt;hr style="margin:16px 0; border:none; border-top:1px solid #eee;" /&gt;';

                    content += '&lt;ul style="list-style:none; padding:0;"&gt;';

                    result.details.forEach(d => {
                        content += '&lt;li style="padding:8px 0; border-bottom:1px solid #eee;"&gt;' +
                            escapeHtml(d.job) +
                            ' → ' +
                            escapeHtml(d.finalName) +
                            '&lt;/li&gt;';
                    });

                    content += '&lt;/ul&gt;';
                    content += '&lt;/div&gt;';

                    JenkinsModal.open({
                        title: i18n.previewResult,
                        content: content,
                        actions: [{
                            text: i18n.confirmImport,
                            type: 'primary',
                            onClick: () => confirmRealImport(form)
                        }]
                    });
                }

                async function confirmRealImport(form) {
                    showProgressBar();

                    var progressBar = document.getElementById('importProgressBar');
                    var progressText = document.getElementById('importProgressText');

                    try {
                        const fd = new FormData(form);
                        fd.set('dryRun', 'false');

                        const conflictMode = document.querySelector('input[name="conflictMode"]:checked');
                        if (conflictMode) {
                            fd.set('overwrite', conflictMode.value === 'overwrite' ? 'true' : 'false');
                            fd.set('rename', conflictMode.value === 'rename' ? 'true' : 'false');
                        }

                        const res = await fetch(form.action, {
                            method: 'POST',
                            body: fd
                        });

                        const text = await res.text();
                        const result = JSON.parse(text);

                        if (result.async &amp;&amp; result.batchId) {
                            listenProgress(result.batchId, progressBar, progressText, form);
                        } else {
                            progressBar.style.width = '100%';
                            if (progressText) progressText.textContent = '';
                            showImportResult(result, form);
                        }

                    } catch (e) {
                        JenkinsModal.setLoading(false);
                        showToast('error', i18n.importError.replace('{0}', e));
                    }
                }

                function openBatch() {
                    const form = document.getElementById('batchImportForm');
                    const dryRunCheckbox = document.getElementById('dryRun');
                    const isDryRun = dryRunCheckbox.checked;

                    JenkinsModal.open({
                        title: isDryRun ? i18n.batchImportDryRunTitle : i18n.batchImportTitle,
                        content: '<div>' + (isDryRun ? i18n.batchImportDryRunContent : i18n.batchImportContent) + '</div>'
                    });
                    JenkinsModal.setFooter([{
                        text: i18n.close,
                        type: 'default',
                        onClick: () => JenkinsModal.close()
                    }, {
                        text: isDryRun ? i18n.startCheck : i18n.startImport,
                        type: 'primary',
                        onClick: () => isDryRun ? submit(form) : submitWithoutDryRun(form)
                    }]);
                }

                function showProgressBar() {
                    JenkinsModal.setContent(
                        '<div style="text-align:center; padding:20px;">' +
                        '<p style="margin-bottom:16px; font-size:14px; color:#333;">' + i18n.importing + '</p>' +
                        '<div style="width:100%; height:6px; background:#e9ecef; border-radius:3px; overflow:hidden;">' +
                        '<div id="importProgressBar" style="width:0%; height:100%; background:linear-gradient(90deg, #2196F3, #4CAF50); border-radius:3px; transition: width 0.3s ease;"></div>' +
                        '</div>' +
                        '<p id="importProgressText" style="margin-top:10px; font-size:12px; color:#666;"></p>' +
                        '</div>'
                    );
                    JenkinsModal.setFooter([]);
                    JenkinsModal.setLoading(false);
                }

                async function submitWithoutDryRun(form) {
                    showProgressBar();

                    var progressBar = document.getElementById('importProgressBar');
                    var progressText = document.getElementById('importProgressText');

                    try {
                        const fd = new FormData(form);
                        fd.set('dryRun', 'false');

                        const res = await fetch(form.action, {
                            method: 'POST',
                            body: fd
                        });

                        const text = await res.text();
                        const result = JSON.parse(text);

                        if (result.async &amp;&amp; result.batchId) {
                            listenProgress(result.batchId, progressBar, progressText, form);
                        } else {
                            progressBar.style.width = '100%';
                            if (progressText) progressText.textContent = '';
                            showImportResult(result, form);
                        }

                    } catch (e) {
                        JenkinsModal.setLoading(false);
                        JenkinsModal.setContent('&lt;div style="color:#dc3545;"&gt;' + i18n.requestFailed.replace('{0}', e) + '&lt;/div&gt;');
                        JenkinsModal.setFooter([{
                            text: i18n.close,
                            type: 'default',
                            onClick: () => JenkinsModal.close()
                        }]);
                    }
                }

                function showImportResult(result, form) {
                    JenkinsModal.setContent(renderResult(result));

                    const buttons = [{
                        text: i18n.close,
                        type: 'default',
                        onClick: () => JenkinsModal.close()
                    }];

                    if (result.redirect &amp;&amp; !result.dryRun) {
                        buttons.push({
                            text: i18n.jump,
                            type: 'primary',
                            onClick: () => location.href = rootURL + '/' + result.redirect
                        });
                    }

                    if (result.dryRun &amp;&amp; result.success &amp;&amp; result.details &amp;&amp; result.details.length &gt; 0 &amp;&amp; result.successCount &gt; 0 &amp;&amp; form) {
                        buttons.unshift({
                            text: i18n.confirmImport,
                            type: 'primary',
                            onClick: () => confirmRealImport(form)
                        });
                    }

                    JenkinsModal.setFooter(buttons);

                    if (result.success) {
                        showToast('success', result.message || i18n.importSuccess);
                    } else {
                        showToast('error', result.message || i18n.importFailed);
                    }
                }

                function listenProgress(batchId, progressBar, progressText, form) {
                    var pollTimer = null;

                    function poll() {
                        fetch('progress?batchId=' + batchId)
                            .then(function(r) { return r.json(); })
                            .then(function(data) {
                                if (data.status === 'NOT_FOUND') {
                                    clearInterval(pollTimer);
                                    return;
                                }

                                if (progressBar &amp;&amp; data.overallProgress != null) {
                                    progressBar.style.width = data.overallProgress + '%';
                                }
                                if (progressText) {
                                    progressText.textContent = i18n.progressStatus.replace('{0}', data.overallProgress).replace('{1}', data.currentJob);
                                }

                                if (data.resultReady) {
                                    clearInterval(pollTimer);
                                    progressBar.style.width = '100%';
                                    if (progressText) progressText.textContent = '';

                                    var result = {
                                        success: data.status !== 'ERROR',
                                        message: data.resultMessage,
                                        dryRun: data.dryRun,
                                        total: data.successCount + data.failCount + data.skipCount,
                                        successCount: data.successCount,
                                        failCount: data.failCount,
                                        skipCount: data.skipCount,
                                        redirect: data.redirect,
                                        details: data.details
                                    };
                                    showImportResult(result, form);
                                }
                            })
                            .catch(function() {
                                clearInterval(pollTimer);
                            });
                    }

                    pollTimer = setInterval(poll, 800);
                    poll();
                }

                function renderExportResult(r) {
                    if (r.details &amp;&amp; r.details.length &gt; 0) {
                        let content = '&lt;div style="max-height:400px; overflow-y:auto;"&gt;';

                        content += '&lt;p&gt;&lt;strong&gt;' + i18n.total + '：&lt;/strong&gt;' + r.total + ' ' + i18n.jobs + '&lt;/p&gt;';
                        content += '&lt;p style="color:#28a745;"&gt;&lt;strong&gt;' + i18n.exported + '：&lt;/strong&gt;' + r.successCount + '&lt;/p&gt;';

                        if (r.skipCount &gt; 0) {
                            content += '&lt;p style="color:#ffc107;"&gt;&lt;strong&gt;' + i18n.skipped + '：&lt;/strong&gt;' + r.skipCount + '&lt;/p&gt;';
                        }

                        if (r.failCount &gt; 0) {
                            content += '&lt;p style="color:#dc3545;"&gt;&lt;strong&gt;' + i18n.failed + '：&lt;/strong&gt;' + r.failCount + '&lt;/p&gt;';
                        }

                        content += '&lt;hr style="margin:16px 0; border:none; border-top:1px solid #eee;" /&gt;';
                        content += '&lt;table style="width:100%; border-collapse:collapse; font-size:13px; table-layout:fixed;"&gt;';
                        content += '&lt;thead&gt;&lt;tr style="background:#f8f9fa;"&gt;&lt;th style="padding:4px 6px; text-align:left; border-bottom:1px solid #ddd; width:45%;"&gt;' + i18n.jobPath + '&lt;/th&gt;&lt;th style="padding:4px 6px; text-align:left; border-bottom:1px solid #ddd; width:15%;"&gt;' + i18n.status + '&lt;/th&gt;&lt;th style="padding:4px 6px; text-align:left; border-bottom:1px solid #ddd; width:40%;"&gt;' + i18n.message + '&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;';
                        content += '&lt;tbody&gt;';

                        r.details.forEach(detail => {
                            let statusColor = '#666';
                            let statusIcon = '';
                            let statusCode = detail.statusCode || detail.status;

                            switch(statusCode) {
                                case 'EXPORTED':
                                    statusColor = '#28a745';
                                    statusIcon = '✔ ';
                                    break;
                                case 'SKIPPED':
                                    statusColor = '#ffc107';
                                    statusIcon = '⏭ ';
                                    break;
                                case 'ERROR':
                                    statusColor = '#dc3545';
                                    statusIcon = '✘ ';
                                    break;
                            }

                            content += '&lt;tr&gt;';
                            content += '&lt;td style="padding:4px 6px; border-bottom:1px solid #eee; color:#666; word-break:break-all; line-height:1.4;"&gt;' + escapeHtml(detail.fullPath || detail.jobPath) + '&lt;/td&gt;';
                            content += '&lt;td style="padding:4px 6px; border-bottom:1px solid #eee; color:' + statusColor + '; font-weight:bold; white-space:nowrap;"&gt;' + statusIcon + escapeHtml(detail.status) + '&lt;/td&gt;';
                            content += '&lt;td style="padding:4px 6px; border-bottom:1px solid #eee; color:#666; word-break:break-all; line-height:1.4;"&gt;' + escapeHtml(detail.message) + '&lt;/td&gt;';
                            content += '&lt;/tr&gt;';
                        });

                        content += '&lt;/tbody&gt;&lt;/table&gt;';
                        content += '&lt;/div&gt;';
                        return content;
                    }

                    const color = r.success ? '#28a745' : '#dc3545';
                    return '&lt;div style="color:' + color + '; padding:10px;"&gt;' + escapeHtml(r.message) + '&lt;/div&gt;';
                }

                async function getCrumb() {
                    try {
                        const res = await fetch(rootURL + '/crumbIssuer/api/json');
                        const data = await res.json();
                        return data;
                    } catch (e) {
                        return null;
                    }
                }

                async function openExportAll() {
                    JenkinsModal.open({
                        title: i18n.exportModalTitle,
                        content: '&lt;div style="text-align:center; padding:20px;"&gt;' + i18n.exportModalContent + '&lt;/div&gt;'
                    });
                    JenkinsModal.setFooter([]);
                    JenkinsModal.setLoading(true);

                    try {
                        const crumb = await getCrumb();
                        const headers = {};
                        if (crumb) {
                            headers[crumb.crumbRequestField] = crumb.crumb;
                        }

                        const res = await fetch('exportAllWithResult', {
                            method: 'POST',
                            headers: headers
                        });

                        const text = await res.text();
                        const result = JSON.parse(text);

                        JenkinsModal.setLoading(false);

                        if (result.success &amp;&amp; result.zipData) {
                            const byteCharacters = atob(result.zipData);
                            const byteNumbers = new Array(byteCharacters.length);
                            for (let i = 0; i &lt; byteCharacters.length; i++) {
                                byteNumbers[i] = byteCharacters.charCodeAt(i);
                            }
                            const byteArray = new Uint8Array(byteNumbers);
                            const blob = new Blob([byteArray], { type: 'application/zip' });
                            const url = URL.createObjectURL(blob);
                            const a = document.createElement('a');
                            a.href = url;
                            const baseName = result.zipFileName || 'jenkins-all-jobs.zip';
                            a.download = baseName;
                            document.body.appendChild(a);
                            a.click();
                            document.body.removeChild(a);
                            URL.revokeObjectURL(url);
                        }

                        JenkinsModal.setContent(renderExportResult(result));

                        JenkinsModal.setFooter([{
                            text: i18n.close,
                            type: 'default',
                            onClick: () => JenkinsModal.close()
                        }]);

                        if (result.success) {
                            showToast('success', result.message || i18n.exportSuccess);
                        } else {
                            showToast('error', result.message || i18n.exportFailed);
                        }

                    } catch (e) {
                        JenkinsModal.setLoading(false);
                        JenkinsModal.setContent('&lt;div style="color:#dc3545;"&gt;' + i18n.exportError.replace('{0}', e) + '&lt;/div&gt;');
                        JenkinsModal.setFooter([{
                            text: i18n.close,
                            type: 'default',
                            onClick: () => JenkinsModal.close()
                        }]);
                    }
                }
            </script>

            <div style="display:flex; gap:24px; width:100%; flex-wrap:wrap;">

            <j:if test="${it.hasAdminPermission()}">
                <div style="flex:1; min-width:280px; padding:20px; background-color:#f8f9fa; border:1px solid #dee2e6; border-radius:6px;">
                    <h2 style="margin-top:0; margin-bottom:12px; font-size:18px; color:#333;">${%export.section.title}</h2>
                    <p style="margin-bottom:16px; color:#666; font-size:14px;">${%export.section.desc}</p>
                    <div style="margin-bottom:16px; padding:10px 14px; background:#e7f3ff; border-left:4px solid #2196F3; border-radius:4px; font-size:13px; color:#333;">
                        ${%export.scope}
                    </div>
                    <button type="button" class="jenkins-button jenkins-button--primary" style="padding:8px 16px;"
                            onclick="openExportAll()">
                        ${%export.btn}
                    </button>
                </div>
            </j:if>

            <j:if test="${it.hasPermission()}">
                <div style="flex:1; min-width:280px; padding:20px; background-color:#f8f9fa; border:1px solid #dee2e6; border-radius:6px;">
                    <h2 style="margin-top:0; margin-bottom:12px; font-size:18px; color:#333;">${%import.section.title}</h2>
                    <p style="margin-bottom:16px; color:#666; font-size:14px;">${%import.section.desc}</p>
                    <div style="margin-bottom:16px; padding:10px 14px; background:#e7f3ff; border-left:4px solid #2196F3; border-radius:4px; font-size:13px; color:#333;">
                        ${%import.target.root}
                    </div>
                        <form method="post" action="batchImport" enctype="multipart/form-data" accept-charset="UTF-8" id="batchImportForm" style="text-align:left;">
                            <table class="form" style="width:100%;">
                                <tr>
                                    <td class="label" style="width:100%; padding-bottom:12px;">
                                        <label for="zipFile" style="font-weight:500; color:#333; font-size:14px;">${%import.file.label}</label>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding-bottom:12px;">
                                        <input type="file" name="zipFile" id="zipFile"
                                               accept=".zip" required="true"
                                               style="padding:6px 10px; border:1px solid #ccc; border-radius:4px; width:100%; box-sizing:border-box;"
                                               onchange="document.getElementById('zipFileName').textContent = this.files[0]?.name || '';" />
                                        <span id="zipFileName" style="margin-left:10px; color:#337ab7; font-size:13px;"></span>
                                        <p class="description" style="margin-top:8px; color:#666; font-size:12px;">${%import.file.desc}</p>
                                    </td>
                                </tr>
                                <tr>
                                <td style="padding-bottom:12px;">
                                    <label style="font-weight:500; color:#333; font-size:14px;">${%import.options.label}</label>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-bottom:8px;">
                                    <input type="checkbox" name="dryRun" id="dryRun" value="true" style="margin-right:8px;" checked="checked" />
                                    <label for="dryRun" style="color:#333; font-size:13px;">${%import.dryRun}</label>
                                    <p class="description" style="margin-top:4px; color:#666; font-size:12px;">${%import.dryRun.desc}</p>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-bottom:12px;">
                                    <label style="font-weight:500; color:#333; font-size:14px;">${%import.conflict.label}</label>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-bottom:8px;">
                                    <input type="radio" name="conflictMode" id="conflictSkip" value="skip" style="margin-right:8px;" checked="checked" />
                                    <label for="conflictSkip" style="color:#333; font-size:13px;">${%import.conflict.skip}</label>
                                    <p class="description" style="margin-top:4px; color:#666; font-size:12px;">${%import.conflict.skip.desc}</p>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-bottom:8px;">
                                    <input type="radio" name="conflictMode" id="conflictOverwrite" value="overwrite" style="margin-right:8px;" />
                                    <label for="conflictOverwrite" style="color:#333; font-size:13px;">${%import.conflict.overwrite}</label>
                                    <p class="description" style="margin-top:4px; color:#666; font-size:12px;">${%import.conflict.overwrite.desc}</p>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-bottom:12px;">
                                    <input type="radio" name="conflictMode" id="conflictRename" value="rename" style="margin-right:8px;" />
                                    <label for="conflictRename" style="color:#333; font-size:13px;">${%import.conflict.rename}</label>
                                    <p class="description" style="margin-top:4px; color:#666; font-size:12px;">${%import.conflict.rename.desc}</p>
                                </td>
                            </tr>
                                <tr>
                                    <td style="padding-top:8px;">
                                        <button type="button" class="jenkins-button jenkins-button--primary" style="padding:8px 16px;"
                                                onclick="openBatch()">
                                            ${%import.btn}
                                        </button>
                                    </td>
                                </tr>
                            </table>
                        </form>
                </div>
            </j:if>

            <j:if test="${!it.hasPermission() and !it.hasAdminPermission()}">
                <div style="flex:1; min-width:280px; padding:20px; background-color:#fff3cd; border:1px solid #ffc107; border-radius:6px; text-align:center;">
                    <p style="color:#856404; font-size:14px; margin:0;">${%no.permission}</p>
                </div>
            </j:if>

            <div style="width:100%; margin-top:20px; padding:16px; background-color:#e3f2fd; border:1px solid #b3d9ff; border-radius:6px;">
                <div style="display:flex; align-items:center; gap:12px;">
                    <span style="font-size:20px;">📡</span>
                    <div style="flex:1;">
                        <h3 style="margin:0 0 4px 0; font-size:14px; color:#1565c0;">${%api.section.title}</h3>
                        <p style="margin:0; font-size:12px; color:#1976d2;">${%api.section.desc}</p>
                    </div>
                    <a href="${rootURL}/jobImportExport/api/" 
                       target="_blank"
                       style="display:inline-block; padding:6px 14px; background:#1976d2; color:#fff; border-radius:4px; font-size:13px; font-weight:500; text-decoration:none; transition:background .2s;"
                       onmouseover="this.style.background='#1565c0'"
                       onmouseout="this.style.background='#1976d2'">
                        ${%api.btn}
                    </a>
                </div>
            </div>

            </div>
        </l:main-panel>
    </l:layout>
</j:jelly>