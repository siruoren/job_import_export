<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form">
    <l:layout title="任务配置管理">
        <l:main-panel>
            <h1>任务配置管理: ${it.item.fullName}</h1>

            <div id="modalOverlay"
                 style="display:none;
                        position:fixed;
                        inset:0;
                        background:rgba(0,0,0,.45);
                        z-index:9999;"></div>

            <div id="modalBox"
                 style="display:none;
                        position:fixed;
                        top:50%;
                        left:50%;
                        transform:translate(-50%,-50%);
                        background:#fff;
                        border-radius:10px;
                        width:700px;
                        max-width:90vw;
                        padding:28px;
                        z-index:10000;
                        box-shadow:0 10px 40px rgba(0,0,0,.25);">

                <h3 id="modalTitle"
                    style="margin:0 0 10px;
                           font-size:18px;
                           color:#222;">
                </h3>

                <div id="modalContent"
                     style="color:#666;
                            line-height:1.7;
                            font-size:14px;">
                </div>

                <div id="modalFooter" style="margin-top:24px;text-align:right;">
                </div>
            </div>

            <script>
                const JenkinsModal = {
                    el: null,
                    loading: false,

                    open({ title, content }) {
                        this.el = document.getElementById('modalBox');
                        document.getElementById('modalTitle').innerText = title;
                        document.getElementById('modalContent').innerHTML = content;

                        document.getElementById('modalOverlay').style.display = 'block';
                        this.el.style.display = 'block';
                    },

                    setContent(html) {
                        document.getElementById('modalContent').innerHTML = html;
                    },

                    setFooter(buttons = []) {
                        const footer = document.getElementById('modalFooter');
                        footer.innerHTML = '';

                        buttons.forEach(b => {
                            const btn = document.createElement('button');
                            btn.innerText = b.text;

                            btn.className =
                                'jenkins-button ' +
                                (b.type === 'primary' ? 'jenkins-button--primary' : '');

                            btn.onclick = b.onClick;
                            footer.appendChild(btn);
                        });
                    },

                    setLoading(flag) {
                        this.loading = flag;
                        document.body.style.cursor = flag ? 'wait' : '';
                    },

                    close() {
                        document.getElementById('modalOverlay').style.display = 'none';
                        document.getElementById('modalBox').style.display = 'none';
                    }
                };

                async function submit(form, extra = {}) {
                    JenkinsModal.setLoading(true);

                    try {
                        const fd = new FormData(form);
                        Object.entries(extra).forEach(([k, v]) => fd.set(k, v));

                        const conflictMode = document.querySelector('input[name="conflictMode"]:checked');
                        if (conflictMode) {
                            fd.set('overwrite', conflictMode.value === 'overwrite' ? 'true' : 'false');
                            fd.set('rename', conflictMode.value === 'rename' ? 'true' : 'false');
                        }

                        const res = await fetch(form.action, {
                            method: 'POST',
                            body: fd
                        });

                        const text = await res.text();
                        const result = JSON.parse(text);

                        JenkinsModal.setLoading(false);

                        JenkinsModal.setContent(renderResult(result));

                        const buttons = [{
                            text: '关闭',
                            type: 'default',
                            onClick: () => JenkinsModal.close()
                        }];

                        if (result.redirect) {
                            buttons.push({
                                text: '跳转',
                                type: 'primary',
                                onClick: () => location.href = result.redirect
                            });
                        }

                        if (result.dryRun &amp;&amp; result.success &amp;&amp; result.details &amp;&amp; result.details.length &gt; 0 &amp;&amp; result.successCount &gt; 0) {
                            buttons.unshift({
                                text: '确认导入',
                                type: 'primary',
                                onClick: () => confirmRealImport(form)
                            });
                        }

                        JenkinsModal.setFooter(buttons);

                    } catch (e) {
                        JenkinsModal.setLoading(false);
                        JenkinsModal.setContent('&lt;div style="color:#dc3545;"&gt;请求失败: ' + e + '&lt;/div&gt;');
                        JenkinsModal.setFooter([{
                            text: '关闭',
                            type: 'default',
                            onClick: () => JenkinsModal.close()
                        }]);
                    }
                }

                async function submitWithoutDryRun(form) {
                    JenkinsModal.setLoading(true);

                    try {
                        const fd = new FormData(form);
                        fd.set('dryRun', 'false');

                        const conflictMode = document.querySelector('input[name="conflictMode"]:checked');
                        if (conflictMode) {
                            fd.set('overwrite', conflictMode.value === 'overwrite' ? 'true' : 'false');
                            fd.set('rename', conflictMode.value === 'rename' ? 'true' : 'false');
                        }

                        const res = await fetch(form.action, {
                            method: 'POST',
                            body: fd
                        });

                        const text = await res.text();
                        const result = JSON.parse(text);

                        JenkinsModal.setLoading(false);

                        JenkinsModal.setContent(renderResult(result));

                        const buttons = [{
                            text: '关闭',
                            type: 'default',
                            onClick: () => JenkinsModal.close()
                        }];

                        if (result.redirect) {
                            buttons.push({
                                text: '跳转',
                                type: 'primary',
                                onClick: () => location.href = result.redirect
                            });
                        }

                        JenkinsModal.setFooter(buttons);

                    } catch (e) {
                        JenkinsModal.setLoading(false);
                        JenkinsModal.setContent('&lt;div style="color:#dc3545;"&gt;请求失败: ' + e + '&lt;/div&gt;');
                        JenkinsModal.setFooter([{
                            text: '关闭',
                            type: 'default',
                            onClick: () => JenkinsModal.close()
                        }]);
                    }
                }

                function renderResult(r) {
                    if (r.details &amp;&amp; r.details.length &gt; 0) {
                        let content = '&lt;div style="max-height:400px; overflow-y:auto;"&gt;';

                        if (r.dryRun) {
                            content += '&lt;p style="color:#17a2b8; font-weight:bold;"&gt;🔍 Dry Run 模式（仅检查，未实际导入）&lt;/p&gt;';
                        }

                        content += '&lt;p&gt;&lt;strong&gt;总计：&lt;/strong&gt;' + r.total + ' 个任务&lt;/p&gt;';
                        content += '&lt;p style="color:#28a745;"&gt;&lt;strong&gt;成功：&lt;/strong&gt;' + r.successCount + ' 个&lt;/p&gt;';

                        if (r.skipCount &gt; 0) {
                            content += '&lt;p style="color:#ffc107;"&gt;&lt;strong&gt;跳过：&lt;/strong&gt;' + r.skipCount + ' 个&lt;/p&gt;';
                        }

                        content += '&lt;p style="color:#dc3545;"&gt;&lt;strong&gt;失败：&lt;/strong&gt;' + r.failCount + ' 个&lt;/p&gt;';

                        content += '&lt;hr style="margin:16px 0; border:none; border-top:1px solid #eee;" /&gt;';

                        content += '&lt;table style="width:100%; border-collapse:collapse; font-size:13px;"&gt;';

                        content += '&lt;thead&gt;&lt;tr style="background:#f8f9fa;"&gt;' +
                            '&lt;th style="padding:8px; text-align:left; border-bottom:1px solid #ddd;"&gt;任务&lt;/th&gt;' +
                            '&lt;th style="padding:8px; text-align:left; border-bottom:1px solid #ddd;"&gt;最终名称&lt;/th&gt;' +
                            '&lt;th style="padding:8px; text-align:left; border-bottom:1px solid #ddd;"&gt;状态&lt;/th&gt;' +
                            '&lt;th style="padding:8px; text-align:left; border-bottom:1px solid #ddd;"&gt;消息&lt;/th&gt;' +
                            '&lt;/tr&gt;&lt;/thead&gt;';

                        content += '&lt;tbody&gt;';

                        r.details.forEach(detail => {
                            let statusColor = '#666';
                            let statusIcon = '';

                            switch(detail.status) {
                                case 'OK':
                                case 'SUCCESS':
                                    statusColor = '#28a745';
                                    statusIcon = '✔ ';
                                    break;

                                case 'ERROR':
                                    statusColor = '#dc3545';
                                    statusIcon = '✘ ';
                                    break;

                                case 'SKIP':
                                case 'SKIP_EXISTS':
                                    statusColor = '#ffc107';
                                    statusIcon = '⏭ ';
                                    break;

                                case 'RENAME':
                                case 'RENAME_JOB':
                                case 'RENAME_FOLDER':
                                    statusColor = '#17a2b8';
                                    statusIcon = '↻ ';
                                    break;

                                case 'OVERWRITE':
                                case 'OVERWRITE_JOB':
                                    statusColor = '#fd7e14';
                                    statusIcon = '⚠ ';
                                    break;
                                    
                                case 'CREATE_FOLDER':
                                    statusColor = '#6f42c1';
                                    statusIcon = '📁 ';
                                    break;
                                    
                                case 'UPDATE_CONFIG':
                                    statusColor = '#17a2b8';
                                    statusIcon = '🔄 ';
                                    break;
                            }

                            content += '&lt;tr&gt;';

                            content += '&lt;td style="padding:8px; border-bottom:1px solid #eee;"&gt;'
                                + escapeHtml(detail.fullPath || detail.jobPath)
                                + '&lt;/td&gt;';

                            let finalName = escapeHtml(detail.fullPath || detail.finalName || detail.jobPath);

                            if (detail.finalName &amp;&amp; detail.finalName !== detail.jobPath) {
                                finalName =
                                    escapeHtml(detail.fullPath || detail.jobPath)
                                    + ' → '
                                    + escapeHtml(detail.fullPath || detail.finalName);
                            }

                            content += '&lt;td style="padding:8px; border-bottom:1px solid #eee; color:#666;"&gt;'
                                + finalName
                                + '&lt;/td&gt;';

                            content += '&lt;td style="padding:8px; border-bottom:1px solid #eee; color:'
                                + statusColor
                                + '; font-weight:bold;"&gt;'
                                + statusIcon
                                + detail.status
                                + '&lt;/td&gt;';

                            let message = escapeHtml(detail.message || '');

                            if (detail.missingPlugins &amp;&amp; detail.missingPlugins.length &gt; 0) {
                                message +=
                                    '&lt;br /&gt;&lt;span style="color:#dc3545; font-size:12px;"&gt;缺少插件: '
                                    + detail.missingPlugins.map(p => escapeHtml(p)).join(', ')
                                    + '&lt;/span&gt;';
                            }

                            content += '&lt;td style="padding:8px; border-bottom:1px solid #eee; color:#666;"&gt;'
                                + message
                                + '&lt;/td&gt;';

                            content += '&lt;/tr&gt;';
                        });

                        content += '&lt;/tbody&gt;&lt;/table&gt;';
                        content += '&lt;/div&gt;';

                        return content;
                    }

                    const color = r.success ? '#28a745' : '#dc3545';

                    return '&lt;div style="color:' + color + '; padding:10px;"&gt;'
                        + escapeHtml(r.message)
                        + '&lt;/div&gt;';
                }

                let importStage = 'INIT';

                function removeToast(toast) {
                    if (!toast) return;
                    if (toast._timer) clearTimeout(toast._timer);
                    toast.style.opacity = '0';
                    toast.style.transform = 'translateY(-10px)';
                    setTimeout(() => {
                        if (toast.parentNode) toast.parentNode.removeChild(toast);
                    }, 250);
                }

                function showToast(type, message, duration = 10000) {
                    const containerId = 'toast-container';
                    let container = document.getElementById(containerId);

                    if (!container) {
                        container = document.createElement('div');
                        container.id = containerId;
                        container.style.position = 'fixed';
                        container.style.top = '24px';
                        container.style.right = '24px';
                        container.style.zIndex = '99999';
                        document.body.appendChild(container);
                    }

                    const toast = document.createElement('div');
                    toast.innerText = message;
                    toast.style.marginBottom = '10px';
                    toast.style.padding = '10px 14px';
                    toast.style.borderRadius = '6px';
                    toast.style.color = '#fff';
                    toast.style.fontSize = '13px';
                    toast.style.boxShadow = '0 6px 18px rgba(0,0,0,.15)';
                    toast.style.cursor = 'pointer';
                    toast.style.transition = 'all .3s ease';
                    toast.style.opacity = '1';
                    toast.style.background = type === 'success' ? '#28a745' : type === 'error' ? '#dc3545' : '#333';
                    toast.onclick = () => removeToast(toast);
                    container.appendChild(toast);

                    toast._timer = setTimeout(() => removeToast(toast), duration);
                }

                function escapeHtml(text) {
                    const div = document.createElement('div');
                    div.textContent = text;
                    return div.innerHTML;
                }

                function openUpdate() {
                    JenkinsModal.open({
                        title: '确认更新配置',
                        content: '&lt;div&gt;是否确认更新「${it.item.fullName}」的配置？&lt;/div&gt;'
                    });
                    JenkinsModal.setFooter([{
                        text: '取消',
                        type: 'default',
                        onClick: () => JenkinsModal.close()
                    }, {
                        text: '确认更新',
                        type: 'primary',
                        onClick: () => submit(document.getElementById('updateForm'))
                    }]);
                }

                function openBatch() {
                    const form = document.getElementById('batchImportForm');
                    const dryRunCheckbox = document.getElementById('dryRun');
                    const isDryRun = dryRunCheckbox.checked;

                    JenkinsModal.open({
                        title: isDryRun ? '批量导入任务（Dry Run）' : '批量导入任务',
                        content: '&lt;div&gt;' + (isDryRun ? '确认执行 Dry Run（仅检查，不实际导入）' : '确认执行批量导入（支持失败重试）') + '&lt;/div&gt;'
                    });
                    JenkinsModal.setFooter([{
                        text: '取消',
                        type: 'default',
                        onClick: () => JenkinsModal.close()
                    }, {
                        text: isDryRun ? '开始检查' : '开始导入',
                        type: 'primary',
                        onClick: () => isDryRun ? submit(form) : submitWithoutDryRun(form)
                    }]);
                }

                async function confirmRealImport(form) {
                    JenkinsModal.setContent('<div style="text-align:center; padding:20px;">正在导入，请稍候...</div>');
                    JenkinsModal.setFooter([]);
                    JenkinsModal.setLoading(true);

                    try {
                        const fd = new FormData(form);
                        fd.set('dryRun', 'false');

                        const conflictMode = document.querySelector('input[name="conflictMode"]:checked');
                        if (conflictMode) {
                            fd.set('overwrite', conflictMode.value === 'overwrite' ? 'true' : 'false');
                            fd.set('rename', conflictMode.value === 'rename' ? 'true' : 'false');
                        }

                        const res = await fetch(form.action, {
                            method: 'POST',
                            body: fd
                        });

                        const text = await res.text();
                        const result = JSON.parse(text);

                        JenkinsModal.setLoading(false);

                        JenkinsModal.setContent(renderResult(result));

                        const buttons = [{
                            text: '关闭',
                            type: 'default',
                            onClick: () => JenkinsModal.close()
                        }];

                        if (result.redirect) {
                            buttons.push({
                                text: '跳转',
                                type: 'primary',
                                onClick: () => location.href = result.redirect
                            });
                        }

                        JenkinsModal.setFooter(buttons);

                        if (result.success) {
                            showToast('success', result.message || '导入成功');
                        } else {
                            showToast('error', result.message || '导入失败');
                        }

                    } catch (e) {
                        JenkinsModal.setLoading(false);
                        showToast('error', '导入失败: ' + e);
                    }
                }

                function listenProgress(batchId) {
                    const es = new EventSource('${it.getUrlName()}/progress?batchId=' + batchId);

                    es.onmessage = e => {
                        const data = JSON.parse(e.data);
                        showToast('info', '进度 ' + data.overallProgress + '% - ' + data.currentJob);

                        if (data.status === 'DONE') {
                            es.close();
                        }
                    };

                    es.onerror = () => es.close();
                }

                function renderExportResult(r) {
                    if (r.details &amp;&amp; r.details.length &gt; 0) {
                        let content = '&lt;div style="max-height:400px; overflow-y:auto;"&gt;';

                        content += '&lt;p&gt;&lt;strong&gt;总计：&lt;/strong&gt;' + r.total + ' 个任务&lt;/p&gt;';
                        content += '&lt;p style="color:#28a745;"&gt;&lt;strong&gt;已导出：&lt;/strong&gt;' + r.successCount + ' 个&lt;/p&gt;';

                        if (r.skipCount &gt; 0) {
                            content += '&lt;p style="color:#ffc107;"&gt;&lt;strong&gt;跳过：&lt;/strong&gt;' + r.skipCount + ' 个&lt;/p&gt;';
                        }

                        if (r.failCount &gt; 0) {
                            content += '&lt;p style="color:#dc3545;"&gt;&lt;strong&gt;失败：&lt;/strong&gt;' + r.failCount + ' 个&lt;/p&gt;';
                        }

                        content += '&lt;hr style="margin:16px 0; border:none; border-top:1px solid #eee;" /&gt;';
                        content += '&lt;table style="width:100%; border-collapse:collapse; font-size:13px;"&gt;';
                        content += '&lt;thead&gt;&lt;tr style="background:#f8f9fa;"&gt;&lt;th style="padding:8px; text-align:left; border-bottom:1px solid #ddd;"&gt;任务路径&lt;/th&gt;&lt;th style="padding:8px; text-align:left; border-bottom:1px solid #ddd;"&gt;状态&lt;/th&gt;&lt;th style="padding:8px; text-align:left; border-bottom:1px solid #ddd;"&gt;消息&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;';
                        content += '&lt;tbody&gt;';

                        r.details.forEach(detail => {
                            let statusColor = '#666';
                            let statusIcon = '';

                            switch(detail.status) {
                                case 'EXPORTED':
                                    statusColor = '#28a745';
                                    statusIcon = '✔ ';
                                    break;
                                case 'SKIPPED':
                                    statusColor = '#ffc107';
                                    statusIcon = '⏭ ';
                                    break;
                                case 'ERROR':
                                    statusColor = '#dc3545';
                                    statusIcon = '✘ ';
                                    break;
                            }

                            content += '&lt;tr&gt;';
                            content += '&lt;td style="padding:8px; border-bottom:1px solid #eee;"&gt;' + escapeHtml(detail.fullPath || detail.jobPath) + '&lt;/td&gt;';
                            content += '&lt;td style="padding:8px; border-bottom:1px solid #eee; color:' + statusColor + '; font-weight:bold;"&gt;' + statusIcon + detail.status + '&lt;/td&gt;';
                            content += '&lt;td style="padding:8px; border-bottom:1px solid #eee; color:#666;"&gt;' + escapeHtml(detail.message) + '&lt;/td&gt;';
                            content += '&lt;/tr&gt;';
                        });

                        content += '&lt;/tbody&gt;&lt;/table&gt;';
                        content += '&lt;/div&gt;';
                        return content;
                    }

                    const color = r.success ? '#28a745' : '#dc3545';
                    return '&lt;div style="color:' + color + '; padding:10px;"&gt;' + escapeHtml(r.message) + '&lt;/div&gt;';
                }

                async function getCrumb() {
                    try {
                        const res = await fetch(rootURL + '/crumbIssuer/api/json');
                        const data = await res.json();
                        return data;
                    } catch (e) {
                        return null;
                    }
                }

                async function executeExport() {
                    const exportType = document.querySelector('input[name="exportType"]:checked').value;

                    if (exportType === 'single') {
                        document.getElementById('singleExportForm')?.submit();
                        return;
                    }

                    JenkinsModal.open({
                        title: '批量导出任务配置',
                        content: '&lt;div style="text-align:center; padding:20px;"&gt;正在导出当前目录及子目录下的所有任务配置，请稍候...&lt;/div&gt;'
                    });
                    JenkinsModal.setFooter([]);
                    JenkinsModal.setLoading(true);

                    try {
                        const crumb = await getCrumb();
                        const headers = {};
                        if (crumb) {
                            headers[crumb.crumbRequestField] = crumb.crumb;
                        }

                        const res = await fetch('batchExport', {
                            method: 'POST',
                            headers: headers
                        });

                        const text = await res.text();
                        
                        let result;
                        try {
                            result = JSON.parse(text);
                        } catch (e) {
                            throw new Error('服务器返回非JSON响应: ' + text.substring(0, 200));
                        }

                        JenkinsModal.setLoading(false);

                        if (result.success &amp;&amp; result.zipData) {
                            const byteCharacters = atob(result.zipData);
                            const byteNumbers = new Array(byteCharacters.length);
                            for (let i = 0; i &lt; byteCharacters.length; i++) {
                                byteNumbers[i] = byteCharacters.charCodeAt(i);
                            }
                            const byteArray = new Uint8Array(byteNumbers);
                            const blob = new Blob([byteArray], { type: 'application/zip' });
                            const url = URL.createObjectURL(blob);
                            const a = document.createElement('a');
                            a.href = url;
                            a.download = result.zipFileName || 'jenkins-jobs-export.zip';
                            document.body.appendChild(a);
                            a.click();
                            document.body.removeChild(a);
                            URL.revokeObjectURL(url);
                        }

                        JenkinsModal.setContent(renderExportResult(result));

                        JenkinsModal.setFooter([{
                            text: '关闭',
                            type: 'default',
                            onClick: () => JenkinsModal.close()
                        }]);

                        if (result.success) {
                            showToast('success', result.message || '导出成功');
                        } else {
                            showToast('error', result.message || '导出失败');
                        }

                    } catch (e) {
                        JenkinsModal.setLoading(false);
                        JenkinsModal.setContent('&lt;div style="color:#dc3545;"&gt;导出失败: ' + e + '&lt;/div&gt;');
                        JenkinsModal.setFooter([{
                            text: '关闭',
                            type: 'default',
                            onClick: () => JenkinsModal.close()
                        }]);
                    }
                }
            </script>

            <div style="display:flex; gap:24px; width:100%; flex-wrap:wrap;">
                <div style="flex:1; min-width:280px; padding:20px; background-color:#f8f9fa; border:1px solid #dee2e6; border-radius:6px;">
                    <h2 style="margin-top:0; margin-bottom:12px; font-size:18px; color:#333;">导出任务配置</h2>
                    <p style="margin-bottom:16px; color:#666; font-size:14px;">选择导出方式并执行导出操作。</p>
                    
                    <div style="margin-bottom:16px;">
                        <label style="display:block; margin-bottom:8px; font-weight:500; color:#333; font-size:14px;">导出类型</label>
                        
                        <div style="margin-bottom:8px;">
                            <label style="display:flex; align-items:center; cursor:pointer;">
                                <input type="radio" name="exportType" value="single" checked="checked" 
                                       style="margin-right:8px;"/>
                                <span style="color:#333;">导出当前配置</span>
                            </label>
                        </div>
                        
                        <j:if test="${it.isFolder()}">
                        <div>
                            <label style="display:flex; align-items:center; cursor:pointer;">
                                <input type="radio" name="exportType" value="batch" 
                                       style="margin-right:8px;"/>
                                <span style="color:#333;">批量导出当前目录及所有子任务</span>
                            </label>
                        </div>
                        </j:if>
                    </div>

                    <j:if test="${it.isFolder()}">
                    <div style="margin-bottom:16px; padding:10px 14px; background:#e7f3ff; border-left:4px solid #2196F3; border-radius:4px; font-size:13px; color:#333;">
                        批量导出范围：<strong>${it.item.fullName}</strong> 目录下所有任务（仅导出有权限的任务）
                    </div>
                    </j:if>

                    <form method="get" action="export" style="display:none;" id="singleExportForm">
                    </form>
                    
                    <button type="button" class="jenkins-button jenkins-button--primary" style="padding:8px 16px;"
                            onclick="executeExport()">
                        执行导出
                    </button>
                </div>

                <j:if test="${it.hasPermission()}">
                <div style="flex:1; min-width:280px; padding:20px; background-color:#f8f9fa; border:1px solid #dee2e6; border-radius:6px;">
                    <h2 style="margin-top:0; margin-bottom:12px; font-size:18px; color:#333;">更新配置</h2>
                    <p style="margin-bottom:16px; color:#666; font-size:14px;">上传新的 XML 配置文件来更新当前任务/文件夹配置。</p>
                    <form method="post" action="update" enctype="multipart/form-data" id="updateForm" style="text-align:left;">
                        <table class="form" style="width:100%;">
                            <tr>
                                <td class="label" style="width:100%; padding-bottom:12px;">
                                    <label for="xmlFile" style="font-weight:500; color:#333; font-size:14px;">配置文件 (XML)</label>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-bottom:12px;">
                                    <input type="file" name="xmlFile" id="xmlFile"
                                           accept=".xml" required="true"
                                           style="padding:6px 10px; border:1px solid #ccc; border-radius:4px; width:100%; box-sizing:border-box;"
                                           onchange="document.getElementById('fileName1').textContent = this.files[0]?.name || '';" />
                                    <span id="fileName1" style="margin-left:10px; color:#337ab7; font-size:13px;"></span>
                                    <p class="description" style="margin-top:8px; color:#666; font-size:12px;">Jenkins 任务配置的 XML 文件</p>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-bottom:12px;">
                                    <p class="description" style="margin-top:8px; color:#666; font-size:12px;">当 XML 文件类型与当前任务类型不匹配时，会导致更新失败。</p>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-top:8px;">
                                    <button type="button" class="jenkins-button jenkins-button--primary" style="padding:8px 16px;"
                                            onclick="openUpdate()">
                                        更新配置
                                    </button>
                                </td>
                            </tr>
                        </table>
                    </form>
                </div>
                </j:if>
                <j:if test="${!it.hasPermission()}">
                <div style="flex:1; min-width:280px;">
                </div>
                </j:if>

                <j:if test="${it.hasPermission()}">
                <div style="flex:1; min-width:280px; padding:20px; background-color:#f8f9fa; border:1px solid #dee2e6; border-radius:6px;">
                    <h2 style="margin-top:0; margin-bottom:12px; font-size:18px; color:#333;">批量导入任务</h2>
                    <p style="margin-bottom:16px; color:#666; font-size:14px;">上传包含多个任务配置的 ZIP 文件来批量创建任务。</p>
                    <j:set var="targetName" value="${it.item.fullName}" />
                    <div style="margin-bottom:16px; padding:10px 14px; background:#e7f3ff; border-left:4px solid #2196F3; border-radius:4px; font-size:13px; color:#333;">
                        任务将导入到目录：<strong>${empty targetName ? 'Jenkins 根目录' : targetName}</strong>
                    </div>
                    <form method="post" action="batchImport" enctype="multipart/form-data" accept-charset="UTF-8" id="batchImportForm" style="text-align:left;">
                        <table class="form" style="width:100%;">
                            <tr>
                                <td class="label" style="width:100%; padding-bottom:12px;">
                                    <label for="zipFile" style="font-weight:500; color:#333; font-size:14px;">ZIP 文件</label>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-bottom:12px;">
                                    <input type="file" name="zipFile" id="zipFile"
                                           accept=".zip" required="true"
                                           style="padding:6px 10px; border:1px solid #ccc; border-radius:4px; width:100%; box-sizing:border-box;"
                                           onchange="document.getElementById('zipFileName').textContent = this.files[0]?.name || '';" />
                                    <span id="zipFileName" style="margin-left:10px; color:#337ab7; font-size:13px;"></span>
                                    <p class="description" style="margin-top:8px; color:#666; font-size:12px;">包含任务配置的 ZIP 文件，支持目录结构（job/config.xml）或扁平结构（job.xml）</p>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-bottom:12px;">
                                    <label style="font-weight:500; color:#333; font-size:14px;">导入选项</label>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-bottom:8px;">
                                    <input type="checkbox" name="dryRun" id="dryRun" value="true" style="margin-right:8px;" checked="checked" />
                                    <label for="dryRun" style="color:#333; font-size:13px;">Dry Run（仅检查不导入）</label>
                                    <p class="description" style="margin-top:4px; color:#666; font-size:12px;">勾选后仅检查任务配置，不实际导入。推荐先使用此模式检查后再导入</p>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-bottom:12px;">
                                    <label style="font-weight:500; color:#333; font-size:14px;">冲突处理</label>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-bottom:8px;">
                                    <input type="radio" name="conflictMode" id="conflictSkip" value="skip" style="margin-right:8px;" checked="checked" />
                                    <label for="conflictSkip" style="color:#333; font-size:13px;">不处理冲突（跳过已存在的任务）</label>
                                    <p class="description" style="margin-top:4px; color:#666; font-size:12px;">如果任务已存在则跳过，不进行任何操作</p>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-bottom:8px;">
                                    <input type="radio" name="conflictMode" id="conflictOverwrite" value="overwrite" style="margin-right:8px;" />
                                    <label for="conflictOverwrite" style="color:#333; font-size:13px;">覆盖已存在的任务</label>
                                    <p class="description" style="margin-top:4px; color:#666; font-size:12px;">如果任务已存在则覆盖原任务（会自动备份原配置）</p>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-bottom:12px;">
                                    <input type="radio" name="conflictMode" id="conflictRename" value="rename" style="margin-right:8px;" />
                                    <label for="conflictRename" style="color:#333; font-size:13px;">自动重命名冲突任务</label>
                                    <p class="description" style="margin-top:4px; color:#666; font-size:12px;">如果任务已存在则自动重命名（test → test_1 → test_2）</p>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-top:8px;">
                                    <button type="button" class="jenkins-button jenkins-button--primary" style="padding:8px 16px;"
                                            onclick="openBatch()">
                                        批量导入
                                    </button>
                                </td>
                            </tr>
                        </table>
                    </form>
                </div>
                </j:if>
                <j:if test="${!it.canImportJobs() or !it.canCreateJob()}">
                <div style="flex:1;">
                </div>
                </j:if>
            </div>
        </l:main-panel>
    </l:layout>
</j:jelly>