<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form">
    <l:layout title="任务配置管理">
        <l:main-panel>
            <h1>任务配置管理: ${instance.item.fullName}</h1>
            
            <j:if test="${!instance.isRootLevel()}">
            <div style="margin-bottom: 30px; padding: 15px; background-color: #f5f5f5; border-radius: 4px;">
                <h2 style="margin-top: 0;">导出当前配置</h2>
                <p>将当前任务/文件夹配置导出为 XML 文件。</p>
                <form method="get" action="export">
                    <button type="submit" class="jenkins-button jenkins-button--primary">
                        导出配置
                    </button>
                </form>
            </div>
            </j:if>
            
            <div style="margin-bottom: 30px; padding: 15px; background-color: #f5f5f5; border-radius: 4px;">
                <h2>更新配置</h2>
                <p>上传新的 XML 配置文件来更新当前任务/文件夹配置。</p>
                <form method="post" action="update" enctype="multipart/form-data">
                    <table class="form">
                        <tr>
                            <td class="label">
                                <label for="xmlFile">配置文件 (XML)</label>
                            </td>
                            <td>
                                <input type="file" name="xmlFile" id="xmlFile" 
                                       accept=".xml" required="true" 
                                       onchange="document.getElementById('fileName1').textContent = this.files[0]?.name || '';" />
                                <span class="description">Jenkins 任务配置的 XML 文件</span>
                                <span id="fileName1" style="margin-left: 10px; color: #337ab7;"></span>
                            </td>
                        </tr>
                        <tr>
                            <td></td>
                            <td>
                                <button type="submit" class="jenkins-button jenkins-button--primary">
                                    更新配置
                                </button>
                            </td>
                        </tr>
                    </table>
                </form>
            </div>
            
            <j:if test="${!instance.isJobType()}">
            <div style="padding: 15px; background-color: #f5f5f5; border-radius: 4px;">
                <h2>导入新任务到当前目录</h2>
                <p>上传 Jenkins 任务配置 XML 文件来在当前目录下创建新任务。</p>
                <form method="post" action="import" enctype="multipart/form-data">
                    <table class="form">
                        <tr>
                            <td class="label">
                                <label for="jobName">任务/子文件夹名称</label>
                            </td>
                            <td>
                                <input type="text" name="jobName" id="jobName" 
                                       class="setting-input" size="50" required="true" />
                                <span class="description">新任务或子文件夹的名称</span>
                            </td>
                        </tr>
                        <tr>
                            <td class="label">
                                <label for="importXmlFile">配置文件 (XML)</label>
                            </td>
                            <td>
                                <input type="file" name="xmlFile" id="importXmlFile" 
                                       accept=".xml" required="true" 
                                       onchange="document.getElementById('fileName2').textContent = this.files[0]?.name || '';" />
                                <span class="description">Jenkins 任务配置的 XML 文件</span>
                                <span id="fileName2" style="margin-left: 10px; color: #337ab7;"></span>
                            </td>
                        </tr>
                        <tr>
                            <td></td>
                            <td>
                                <button type="submit" class="jenkins-button jenkins-button--primary">
                                    导入任务
                                </button>
                            </td>
                        </tr>
                    </table>
                </form>
            </div>
            </j:if>
        </l:main-panel>
    </l:layout>
</j:jelly>