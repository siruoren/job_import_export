<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form">
    <l:layout title="任务配置管理">
        <l:main-panel>
            <h1>任务配置管理: ${it.item.fullName}</h1>

            <div id="modalOverlay"
                 style="display:none;
                        position:fixed;
                        inset:0;
                        background:rgba(0,0,0,.45);
                        z-index:9999;"></div>

            <div id="modalBox"
                 style="display:none;
                        position:fixed;
                        top:50%;
                        left:50%;
                        transform:translate(-50%,-50%);
                        background:#fff;
                        border-radius:10px;
                        width:420px;
                        padding:28px;
                        z-index:10000;
                        box-shadow:0 10px 40px rgba(0,0,0,.25);">

                <h3 id="modalTitle"
                    style="margin:0 0 10px;
                           font-size:18px;
                           color:#222;">
                </h3>

                <div id="modalContent"
                     style="color:#666;
                            line-height:1.7;
                            font-size:14px;">
                </div>

                <div style="margin-top:24px;text-align:right;">
                    <button type="button"
                            class="jenkins-button"
                            onclick="hideModal()">
                        取消
                    </button>

                    <button type="button"
                            class="jenkins-button jenkins-button--primary"
                            onclick="confirmSubmit()">
                        确认
                    </button>
                </div>
            </div>

            <script>
                let currentFormId = null;

                function setLoading(loading) {
                    document.querySelectorAll('button').forEach(btn => {
                        btn.disabled = loading;
                    });

                    if (loading) {
                        document.body.style.cursor = 'wait';
                    } else {
                        document.body.style.cursor = '';
                    }
                }

                function removeToast(toast) {
                    if (!toast) return;

                    if (toast._timer) {
                        clearTimeout(toast._timer);
                    }

                    toast.style.opacity = '0';
                    toast.style.transform = 'translateY(-10px)';

                    setTimeout(() => {
                        if (toast.parentNode) {
                            toast.parentNode.removeChild(toast);
                        }
                    }, 250);
                }

                function showToast(type, message, duration = 3000) {
                    const containerId = 'toast-container';

                    let container = document.getElementById(containerId);

                    if (!container) {
                        container = document.createElement('div');
                        container.id = containerId;
                        container.style.position = 'fixed';
                        container.style.top = '24px';
                        container.style.right = '24px';
                        container.style.zIndex = '99999';
                        document.body.appendChild(container);
                    }

                    const toast = document.createElement('div');

                    toast.innerText = message;

                    toast.style.marginBottom = '10px';
                    toast.style.padding = '10px 14px';
                    toast.style.borderRadius = '6px';
                    toast.style.color = '#fff';
                    toast.style.fontSize = '13px';
                    toast.style.boxShadow = '0 6px 18px rgba(0,0,0,.15)';
                    toast.style.cursor = 'pointer';
                    toast.style.transition = 'all .3s ease';
                    toast.style.opacity = '1';

                    toast.style.background =
                        type === 'success' ? '#28a745' :
                        type === 'error' ? '#dc3545' :
                        '#333';

                    toast.onclick = () => removeToast(toast);

                    container.appendChild(toast);

                    toast._timer = setTimeout(() => {
                        removeToast(toast);
                    }, duration);
                }

                function showModal(title, content, formId) {
                    currentFormId = formId;

                    document.getElementById('modalTitle').innerText = title;
                    document.getElementById('modalContent').innerHTML = content;

                    document.getElementById('modalOverlay').style.display = 'block';
                    document.getElementById('modalBox').style.display = 'block';
                }

                function hideModal() {
                    document.getElementById('modalOverlay').style.display = 'none';
                    document.getElementById('modalBox').style.display = 'none';

                    currentFormId = null;
                }

                async function confirmSubmit() {
                    if (!currentFormId) {
                        return;
                    }

                    const form = document.getElementById(currentFormId);

                    const formData = new FormData(form);

                    setLoading(true);

                    try {
                        const response = await fetch(form.action, {
                            method: 'POST',
                            body: formData
                        });

                        const text = await response.text();
                        let result;

                        try {
                            result = JSON.parse(text);
                        } catch (e) {
                            hideModal();
                            showToast('error', '服务器返回非JSON格式');
                            return;
                        }

                        hideModal();

                        if (result.success) {
                            showToast('success', result.message);

                            if (result.redirect) {
                                setTimeout(() => {
                                    window.location.href = result.redirect;
                                }, 1200);
                            }
                        } else {
                            showToast('error', result.message);
                        }

                    } catch (e) {
                        hideModal();
                        showToast('error', '请求失败：' + e);
                    } finally {
                        setLoading(false);
                    }
                }
            </script>


            <div style="margin-bottom: 24px; padding: 20px; background-color: #f8f9fa; border: 1px solid #dee2e6; border-radius: 6px;">
                <h2 style="margin-top: 0; margin-bottom: 12px; font-size: 18px; color: #333;">导出当前配置</h2>
                <p style="margin-bottom: 16px; color: #666;">将当前任务/文件夹配置导出为 XML 文件。</p>
                <form method="get" action="export" style="text-align: left;">
                    <button type="submit" class="jenkins-button jenkins-button--primary" style="padding: 8px 16px;">
                        导出配置
                    </button>
                </form>
            </div>


            <div style="margin-bottom: 24px; padding: 20px; background-color: #f8f9fa; border: 1px solid #dee2e6; border-radius: 6px;">
                <h2 style="margin-top: 0; margin-bottom: 12px; font-size: 18px; color: #333;">更新配置</h2>
                <p style="margin-bottom: 16px; color: #666;">上传新的 XML 配置文件来更新当前任务/文件夹配置。</p>
                <form method="post" action="update" enctype="multipart/form-data" id="updateForm" style="text-align: left;">
                    <table class="form" style="width: 100%;">
                        <tr>
                            <td class="label" style="width: 180px; padding-right: 12px;">
                                <label for="xmlFile" style="font-weight: 500; color: #333;">配置文件 (XML)</label>
                            </td>
                            <td style="padding-bottom: 12px;">
                                <input type="file" name="xmlFile" id="xmlFile"
                                       accept=".xml" required="true"
                                       style="padding: 6px 10px; border: 1px solid #ccc; border-radius: 4px; width: 400px;"
                                       onchange="document.getElementById('fileName1').textContent = this.files[0]?.name || '';" />
                                <span class="description" style="margin-left: 10px; color: #666; font-size: 13px;">Jenkins 任务配置的 XML 文件</span>
                                <span id="fileName1" style="margin-left: 10px; color: #337ab7; font-size: 13px;"></span>
                            </td>
                        </tr>
                        <tr>
                            <td class="label" style="width: 180px; padding-right: 12px;">
                                <label for="forceReplace" style="font-weight: 500; color: #333;">强制替换</label>
                            </td>
                            <td style="padding-bottom: 12px;">
                                <input type="checkbox" name="forceReplace" id="forceReplace" value="true"
                                       style="margin-right: 8px;" />
                                <span class="description" style="color: #666; font-size: 13px;">当 XML 文件类型与当前任务类型不匹配时，强制替换配置文件（可能导致任务无法正常运行）</span>
                            </td>
                        </tr>
                        <tr>
                            <td></td>
                            <td style="padding-top: 8px;">
                                <button type="button" class="jenkins-button jenkins-button--primary" style="padding: 8px 16px;"
                                        onclick="showModal('确认更新配置', '是否确认更新「${it.item.fullName}」的配置？', 'updateForm')">
                                    更新配置
                                </button>
                            </td>
                        </tr>
                    </table>
                </form>
            </div>

            <j:if test="${it.canImportJobs()}">
            <div style="padding: 20px; background-color: #f8f9fa; border: 1px solid #dee2e6; border-radius: 6px;">
                <h2 style="margin-top: 0; margin-bottom: 12px; font-size: 18px; color: #333;">导入新任务到当前目录</h2>
                <p style="margin-bottom: 16px; color: #666;">上传 Jenkins 任务配置 XML 文件来在当前目录下创建新任务。</p>
                <form method="post" action="import" enctype="multipart/form-data" accept-charset="UTF-8" id="importForm" style="text-align: left;">
                    <table class="form" style="width: 100%;">
                        <tr>
                            <td class="label" style="width: 180px; padding-right: 12px;">
                                <label for="jobName" style="font-weight: 500; color: #333;">任务/子文件夹名称</label>
                            </td>
                            <td style="padding-bottom: 12px;">
                                <input type="text" name="jobName" id="jobName"
                                       class="setting-input" required="true"
                                       style="padding: 6px 10px; border: 1px solid #ccc; border-radius: 4px; width: 400px;" />
                                <span class="description" style="margin-left: 10px; color: #666; font-size: 13px;">新任务或子文件夹的名称</span>
                            </td>
                        </tr>
                        <tr>
                            <td class="label" style="width: 180px; padding-right: 12px;">
                                <label for="importXmlFile" style="font-weight: 500; color: #333;">配置文件 (XML)</label>
                            </td>
                            <td style="padding-bottom: 12px;">
                                <input type="file" name="xmlFile" id="importXmlFile"
                                       accept=".xml" required="true"
                                       style="padding: 6px 10px; border: 1px solid #ccc; border-radius: 4px; width: 400px;"
                                       onchange="document.getElementById('fileName2').textContent = this.files[0]?.name || '';" />
                                <span class="description" style="margin-left: 10px; color: #337ab7; font-size: 13px;">Jenkins 任务配置的 XML 文件</span>
                                <span id="fileName2" style="margin-left: 10px; color: #337ab7; font-size: 13px;"></span>
                            </td>
                        </tr>
                        <tr>
                            <td></td>
                            <td style="padding-top: 8px;">
                                <button type="button" class="jenkins-button jenkins-button--primary" style="padding: 8px 16px;"
                                        onclick="var name=document.getElementById('jobName').value; showModal('确认创建任务', '是否确认创建任务「' + name + '」？', 'importForm')">
                                    导入任务
                                </button>
                            </td>
                        </tr>
                    </table>
                </form>
            </div>
            </j:if>
        </l:main-panel>
    </l:layout>
</j:jelly>